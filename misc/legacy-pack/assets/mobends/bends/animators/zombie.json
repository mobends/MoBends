{
  "formatVersion": 2,
  "extends": "mobends:bends/animators/legacy/biped.json",
  "layers": [
    {
      "@when": {"eq": ["entity.animationSet", 0]},
      "defaultOnEntry": "lean",
      "nodes": {
        "lean": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/legacy/zombie/lean.json"},
                "@space": {"@default": "pre", "body": "post", "root": "override"},
                "@smoothing": {"root": [null, 0.83, null]},
                "@vectorModes": {"root": "retarget"}
              },
              {
                "@when": {"and": [{"not": ["entityIsStandingStill"]}, {"eq": ["entity.walkingState", 1]}]},
                "core:clip": {"animationKey": "mobends:bends/animations/legacy/zombie/lean_arms_up.json"},
                "@space": "override"
              }
            ]
          }
        }
      }
    },
    {
      "@when": {"eq": ["entity.animationSet", 1]},
      "defaultOnEntry": "stumble",
      "nodes": {
        "stumble": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/legacy/zombie/stumble_base.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]}
                },
                "@smoothing": {"rightLeg": 1, "leftLeg": 1, "rightArm": 1, "leftArm": 1, "body": 2}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/legacy/zombie/stumble_swing.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@space": "post"
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/legacy/zombie/stumble_head.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]}
                },
                "@space": "pre"
              }
            ]
          }
        }
      }
    }
  ]
}

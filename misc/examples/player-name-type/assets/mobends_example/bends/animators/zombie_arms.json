{
  "formatVersion": 2,
  "extends": "mobends:bends/animators/player.json",
  "layers": [
    {
      "defaultOnEntry": "zombie_arms",
      "nodes": {
        "zombie_arms": {
          "core:pose": {
            "pose": [
              {
                "core:axis_rotate": {
                  "bone": "rightArm",
                  "axis": "x",
                  "angle": {"add": [{"mul": [{"sin": [{"mul": ["ticks", 0.1]}]}, 6]}, -85]}
                },
                "@space": "override"
              },
              {
                "core:axis_rotate": {
                  "bone": "leftArm",
                  "axis": "x",
                  "angle": {"add": [{"mul": [{"sin": [{"add": [{"mul": ["ticks", 0.1]}, 3.14]}]}, 6]}, -85]}
                },
                "@space": "override"
              },
              {"core:axis_rotate": {"bone": "rightForeArm", "axis": "x", "angle": 0}, "@space": "override"},
              {"core:axis_rotate": {"bone": "leftForeArm", "axis": "x", "angle": 0}, "@space": "override"}
            ]
          }
        }
      }
    }
  ]
}

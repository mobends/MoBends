{
  "formatVersion": 2,
  "@comment": "One layer on top of the player's animator: it lets the player's own pose through while they move, and raises the right arm to wave while they stand still.",
  "layers": [
    {
      "select": [
        {"when": "STANDING_STILL", "then": "wave", "transitionDuration": 8},
        {"then": "through", "transitionDuration": 8}
      ],
      "nodes": {
        "through": {"core:fallthrough": {}},
        "wave": {
          "core:pose": {
            "pose": [
              {"core:axis_rotate": {"bone": "rightArm", "axis": "X", "angle": -165}, "@space": "OVERRIDE"},
              {"core:axis_rotate": {"bone": "rightArm", "axis": "Z", "angle": "node.sway"}, "@space": "POST"},
              {"core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": -20}, "@space": "OVERRIDE"}
            ]
          },
          "@define": {"sway": {"live": {"mul": [{"sin": [{"mul": ["elapsed", 0.5]}]}, 25]}}}
        }
      }
    }
  ]
}

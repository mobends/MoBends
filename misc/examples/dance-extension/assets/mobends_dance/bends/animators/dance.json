{
  "formatVersion": 2,
  "@comment": "One layer on top of a mob's own animator: while it stands still it bounces on every beat (120 BPM, a beat every 10 ticks), sways to one side per beat, tilts with the sway and nods. Every dancing mob keeps the same beat: it follows the game's tick clock.",
  "@define": {
    "beat": {"live": {"mul": ["ticks", 0.31415927]}},
    "sway": {"live": {"sin": ["animator.beat"]}},
    "bounce": {"live": {"abs": [{"sin": ["animator.beat"]}]}}
  },
  "layers": [
    {
      "select": [
        {"when": {"and": ["entityIsStandingStill", "entityIsOnGround"]}, "then": "dance", "transitionDuration": 6},
        {"then": "rest", "transitionDuration": 6}
      ],
      "nodes": {
        "rest": {
          "@comment": "The mob's own animation doesn't move its whole body, so this node puts it back in place (a fallthrough node would leave it wherever the dance stopped).",
          "core:pose": {
            "pose": [
              {"core:vector": {"bone": "globalOffset", "x": 0, "y": 0, "z": 0}, "@snap": true},
              {
                "core:axis_rotate": {"bone": "renderRotation", "axis": "z", "angle": 0},
                "@space": "override",
                "@snap": true
              }
            ]
          }
        },
        "dance": {
          "core:pose": {
            "pose": [
              {
                "core:vector": {
                  "bone": "globalOffset",
                  "x": {"mul": ["animator.sway", 1.5]},
                  "y": {"mul": ["animator.bounce", 2.5]},
                  "z": 0
                },
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "renderRotation", "axis": "z", "angle": {"mul": ["animator.sway", -8]}},
                "@space": "override",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": {"mul": [{"sub": [1, "animator.bounce"]}, 15]}},
                "@space": "post"
              }
            ]
          }
        }
      }
    }
  ]
}

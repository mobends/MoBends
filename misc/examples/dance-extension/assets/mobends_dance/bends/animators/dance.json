{
  "formatVersion": 2,
  "comment": "One layer on top of a mob's own animator: while it stands still it bounces on every beat (120 BPM, a beat every 10 ticks), sways to one side per beat, tilts with the sway and nods. Every dancing mob keeps the same beat: it follows the game's tick clock.",
  "expressions": {
    "beat": {"mul": ["ticks", 0.31415927]},
    "sway": {"sin": ["beat"]},
    "bounce": {"abs": [{"sin": ["beat"]}]}
  },
  "layers": [
    {
      "type": "KEYFRAME",
      "entryNode": "rest",
      "nodes": {
        "rest": {
          "comment": "The mob's own animation doesn't move its whole body, so this node puts it back in place (a fallthrough node would leave it wherever the dance stopped).",
          "pose": [
            {"driver": "core:vector", "bone": "globalOffset", "x": 0, "y": 0, "z": 0, "snap": true},
            {"driver": "core:axis_rotate", "bone": "renderRotation", "axis": "Z", "angle": 0, "space": "OVERRIDE", "snap": true}
          ],
          "connections": [
            {
              "target": "dance",
              "transitionDuration": 6,
              "triggerCondition": {"type": "core:and", "conditions": [
                {"type": "core:state", "state": "STANDING_STILL"},
                {"type": "core:state", "state": "ON_GROUND"}
              ]}
            }
          ]
        },
        "dance": {
          "tags": ["dance"],
          "pose": [
            {"driver": "core:vector", "bone": "globalOffset", "x": {"mul": ["sway", 1.5]}, "y": {"mul": ["bounce", 2.5]}, "z": 0, "snap": true},
            {"driver": "core:axis_rotate", "bone": "renderRotation", "axis": "Z", "angle": {"mul": ["sway", -8]}, "space": "OVERRIDE", "snap": true},
            {"driver": "core:axis_rotate", "bone": "head", "axis": "X", "angle": {"mul": [{"sub": [1, "bounce"]}, 15]}, "space": "POST"}
          ],
          "connections": [
            {
              "target": "rest",
              "transitionDuration": 6,
              "triggerCondition": {"type": "core:or", "conditions": [
                {"type": "core:state", "state": "MOVING_HORIZONTALLY"},
                {"type": "core:state", "state": "AIRBORNE"}
              ]}
            }
          ]
        }
      }
    }
  ]
}

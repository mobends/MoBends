{
  "formatVersion": 2,
  "@comment": "The player. The body bends at the hips and carries the head and arms; the head doesn't turn with it, so it looks where the player looks; elbows and knees split the limbs, and the sleeves and trousers ride them. The cape hangs from the body.",
  "entity": "minecraft:player",
  "key": "player",
  "unlocalizedName": "mobends.player",
  "model": "net.minecraft.client.model.ModelPlayer",
  "animator": "mobends:bends/animators/player.json",
  "options": {
    "spinAttack": {"default": true, "label": "mobends.option.spin_attack"}
  },
  "bones": [
    {"name": "body", "vanilla": {"field": "bipedBody"}, "pivot": [0, 12, 0]},
    {"name": "head", "vanilla": {"field": "bipedHead"}, "parent": "body", "inheritRotation": false},
    {"name": "headwear", "vanilla": {"field": "bipedHeadwear"}, "parent": "head"},
    {"name": "bodywear", "vanilla": {"field": "bipedBodyWear"}, "overlay": "body"},
    {"name": "rightArm", "vanilla": {"field": "bipedRightArm"}, "parent": "body",
     "split": {"axis": "y", "at": [0.5], "names": ["rightForeArm"], "hinge": "back"}, "inflate": [[0.01, 0, 0.01], [0, 0, 0]]},
    {"name": "leftArm", "vanilla": {"field": "bipedLeftArm"}, "parent": "body",
     "split": {"axis": "y", "at": [0.5], "names": ["leftForeArm"], "hinge": "back"}, "inflate": [[0.01, 0, 0.01], [0, 0, 0]]},
    {"name": "rightArmwear", "vanilla": {"field": "bipedRightArmwear"}, "overlay": "rightArm", "inflate": [[0.0025, 0, 0.0025], [0.005, 0, 0.005]]},
    {"name": "leftArmwear", "vanilla": {"field": "bipedLeftArmwear"}, "overlay": "leftArm", "inflate": [[0.0025, 0, 0.0025], [0.005, 0, 0.005]]},
    {"name": "rightLeg", "vanilla": {"field": "bipedRightLeg"}, "pivot": [0, 12, 0],
     "split": {"axis": "y", "at": [0.5], "names": ["rightForeLeg"], "hinge": "front", "caps": true}, "inflate": [[0, 0, 0], [0.01, 0, 0.01]]},
    {"name": "leftLeg", "vanilla": {"field": "bipedLeftLeg"}, "pivot": [0, 12, 0],
     "split": {"axis": "y", "at": [0.5], "names": ["leftForeLeg"], "hinge": "front", "caps": true}, "inflate": [[0, 0, 0], [0.01, 0, 0.01]]},
    {"name": "rightLegwear", "vanilla": {"field": "bipedRightLegwear"}, "overlay": "rightLeg", "inflate": [[0, 0, 0], [0.005, 0, 0.005]]},
    {"name": "leftLegwear", "vanilla": {"field": "bipedLeftLegwear"}, "overlay": "leftLeg", "inflate": [[0, 0, 0], [0.005, 0, 0.005]]},
    {"name": "cape", "parent": "body", "position": [0, 0, 0]}
  ],
  "components": {
    "rightHeldItem": "core:orientation",
    "leftHeldItem": "core:orientation",
    "swordTrail": "mobends:sword_trail",
    "capeWave": "mobends:cape_wave"
  },
  "attackComboTicks": 6,
  "smoothing": {"root": 0.5},
  "renderer": {
    "@comment": "Vanilla lowers a sneaking player; the bent sneak pose needs it higher.",
    "sneakOffset": 5,
    "flyingSneakOffset": 4
  },
  "layers": {
    "mobends:armor": {},
    "mobends:held_item": {},
    "mobends:custom_head": {"bone": "head"},
    "mobends:cape": {},
    "mobends:elytra": {},
    "mobends:accessories": {}
  },
  "@define": {
    "flightSpeedFactor": {"live": {"div": [{"clamp": ["entitySpeed", 0, 0.2]}, 0.2]}},
    "flightPitch": {"live": {"mul": [{"atan2": ["entityXZSpeed", "entityMotionY"]}, 57.29578, "entity.flightSpeedFactor"]}},
    "liftedOff": {"live": {"or": [{"fell": ["entityIsOnGround"]}, {"decreased": ["entityTicksInAir"]}]}},
    "standingOnLeftLeg": {"@comment": "The sprint cycle swings the left leg by -72 cos(phase) degrees (positive is back), phase = entityLimbSwing * 0.6662 * 0.8, so the left leg is the one on the ground (sweeping back) while sin(phase) > 0. A sprint jump pushes off the leg on the ground and leads with the other: sprintJumpLeg (true leads with the right leg) is that, read as the entity lifts off.", "live": {"gt": [{"sin": [{"mul": ["entityLimbSwing", 0.53296]}]}, 0]}},
    "nextSprintJumpLeg": {"@comment": "Jumping again within a few ticks of landing pushes off the leg that led the last jump, which is in front now, so the legs swap; after a longer stay on the ground, the sprint cycle picks.", "live": {"if": [{"lt": ["entityTicksAfterTouchdown", 5]}, {"not": ["entity.sprintJumpLeg"]}, "entity.standingOnLeftLeg"]}},
    "sprintJumpLeg": {"state": false},
    "sprintJumpLegSwitched": {"state": false}
  },
  "@on": {
    "update": [
      {"@when": {"and": ["entity.liftedOff", {"not": ["entity.sprintJumpLegSwitched"]}]}, "set": ["entity.sprintJumpLeg", "entity.nextSprintJumpLeg"]},
      {"@when": "entity.liftedOff", "set": ["entity.sprintJumpLegSwitched", true]},
      {"@when": {"lt": ["entityTickMotionY", 0]}, "set": ["entity.sprintJumpLegSwitched", false]},
      {"@when": {"and": [{"gt": ["entityTickMotionY", 0]}, {"not": ["entity.sprintJumpLegSwitched"]}]}, "set": ["entity.sprintJumpLeg", "entity.nextSprintJumpLeg"]},
      {"@when": {"gt": ["entityTickMotionY", 0]}, "set": ["entity.sprintJumpLegSwitched", true]}
    ]
  }
}

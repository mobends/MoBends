{
  "formatVersion": 2,
  "extends": "mobends:bends/animators/biped.json",
  "layers": [
    {
      "mode": "additive",
      "additiveSpace": {"@default": "pre", "root": "override"},
      "@when": {"or": ["animator.standing", "animator.walking"]},
      "defaultOnEntry": "hunch",
      "nodes": {
        "hunch": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/pigzombie/pose_post.json"},
                "@space": "post"
              },
              {
                "core:clip": {"animationKey": "mobends:bends/animations/pigzombie/pose_pre.json"},
                "@space": "pre"
              },
              {
                "@when": "animator.standing",
                "core:clip": {"animationKey": "mobends:bends/animations/pigzombie/stand_offset.json"},
                "@damping": {"root": [null, 1.2, null]},
                "@vectorModes": {"root": "retarget"}
              },
              {
                "@when": "animator.walking",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/pigzombie/walk_bob.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {"root": [null, 1.2, null]},
                "@vectorModes": {"root": "retarget"}
              }
            ]
          }
        }
      }
    },
    {
      "@when": {"gt": ["entitySwingProgress", 0]},
      "defaultOnEntry": "slash",
      "mirror": {
        "@when": "entityIsLeftHanded",
        "pairs": [
          ["leftArm", "rightArm"],
          ["leftForeArm", "rightForeArm"],
          ["leftLeg", "rightLeg"],
          ["leftForeLeg", "rightForeLeg"],
          ["leftHeldItem", "rightHeldItem"]
        ]
      },
      "nodes": {
        "slash": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/pigzombie/slash.json",
                  "frame": "entityTicksAfterAttack"
                },
                "@mirror": true,
                "@damping": {
                  "body": 0.9,
                  "head": 0.9,
                  "rightArm": 0.9,
                  "leftArm": 0.3,
                  "rightForeArm": 0.3,
                  "leftForeArm": 0.3,
                  "localOffset": 0.3
                },
                "@vectorModes": {"localOffset": "slide"}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"}, "@space": "pre"},
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"},
                "@space": "post",
                "@mirror": true
              },
              {
                "@when": {"and": ["entityIsStandingStill", {"not": ["entityIsRiding"]}]},
                "core:clip": {
                  "animationKey": "mobends:bends/animations/pigzombie/slash_still.json",
                  "bones": ["leftLeg", "rightLeg", "rightForeLeg", "root"]
                },
                "@damping": {"root": [null, 1.2, null]},
                "@vectorModes": {"root": "retarget"}
              },
              {
                "@when": {"and": ["entityIsStandingStill", {"not": ["entityIsRiding"]}]},
                "core:clip": {
                  "animationKey": "mobends:bends/animations/pigzombie/slash_still.json",
                  "bones": ["renderRotation"]
                },
                "@mirror": true,
                "@damping": {"renderRotation": 0.6}
              },
              {
                "core:axis_rotate": {"bone": "rightHeldItem", "axis": "x", "angle": 50},
                "@space": "override",
                "@snap": true,
                "@mirror": true,
                "@damping": {"rightHeldItem": 0.9}
              }
            ]
          }
        }
      }
    }
  ]
}

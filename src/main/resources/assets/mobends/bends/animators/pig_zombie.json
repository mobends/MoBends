{
  "formatVersion": 2,
  "extends": "mobends:bends/animators/biped.json",
  "layers": [
    {
      "mode": "ADDITIVE",
      "additiveSpace": {
        "default": "PRE",
        "root": "OVERRIDE"
      },
      "when": {
        "or": [
          {
            "core:action": [
              "stand"
            ]
          },
          {
            "core:action": [
              "walk"
            ]
          }
        ]
      },
      "defaultOnEntry": "hunch",
      "nodes": {
        "hunch": {
          "type": "core:pose",
          "tags": [
            "hunch"
          ],
          "pose": [
            {
              "animationKey": "mobends:bends/animations/pigzombie/pose_post.json",
              "space": "POST"
            },
            {
              "animationKey": "mobends:bends/animations/pigzombie/pose_pre.json",
              "space": "PRE"
            },
            {
              "animationKey": "mobends:bends/animations/pigzombie/stand_offset.json",
              "when": {
                "core:action": [
                  "stand"
                ]
              },
              "damping": {
                "root": [
                  null,
                  1.2,
                  null
                ]
              },
              "vectorModes": {
                "root": "RETARGET"
              }
            },
            {
              "animationKey": "mobends:bends/animations/pigzombie/walk_bob.json",
              "frame": {
                "mod": [
                  {
                    "mul": [
                      "limbSwing",
                      0.6662
                    ]
                  },
                  "clipLength"
                ]
              },
              "when": {
                "core:action": [
                  "walk"
                ]
              },
              "damping": {
                "root": [
                  null,
                  1.2,
                  null
                ]
              },
              "vectorModes": {
                "root": "RETARGET"
              }
            }
          ]
        }
      }
    },
    {
      "when": {
        "gt": [
          "entitySwingProgress",
          0
        ]
      },
      "defaultOnEntry": "slash",
      "mirror": {
        "when": "LEFT_HANDED",
        "pairs": [
          [
            "leftArm",
            "rightArm"
          ],
          [
            "leftForeArm",
            "rightForeArm"
          ],
          [
            "leftLeg",
            "rightLeg"
          ],
          [
            "leftForeLeg",
            "rightForeLeg"
          ],
          [
            "renderLeftItemRotation",
            "renderRightItemRotation"
          ]
        ]
      },
      "nodes": {
        "slash": {
          "type": "core:pose",
          "tags": [
            "attack",
            "attack_slash_inward"
          ],
          "pose": [
            {
              "animationKey": "mobends:bends/animations/pigzombie/slash.json",
              "frame": "ticksAfterAttack",
              "mirror": true,
              "damping": {
                "body": 0.9,
                "head": 0.9,
                "rightArm": 0.9,
                "leftArm": 0.3,
                "rightForeArm": 0.3,
                "leftForeArm": 0.3,
                "localOffset": 0.3
              },
              "vectorModes": {
                "localOffset": "SLIDE"
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Y",
              "angle": "headYaw",
              "space": "PRE"
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "X",
              "angle": "headPitch",
              "space": "POST",
              "mirror": true
            },
            {
              "animationKey": "mobends:bends/animations/pigzombie/slash_still.json",
              "bones": [
                "leftLeg",
                "rightLeg",
                "rightForeLeg",
                "root"
              ],
              "when": {
                "and": [
                  "STANDING_STILL",
                  {
                    "not": [
                      "RIDING"
                    ]
                  }
                ]
              },
              "damping": {
                "root": [
                  null,
                  1.2,
                  null
                ]
              },
              "vectorModes": {
                "root": "RETARGET"
              }
            },
            {
              "animationKey": "mobends:bends/animations/pigzombie/slash_still.json",
              "bones": [
                "renderRotation"
              ],
              "mirror": true,
              "when": {
                "and": [
                  "STANDING_STILL",
                  {
                    "not": [
                      "RIDING"
                    ]
                  }
                ]
              },
              "damping": {
                "renderRotation": 0.6
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "renderRightItemRotation",
              "axis": "X",
              "angle": 50,
              "space": "OVERRIDE",
              "snap": true,
              "mirror": true,
              "damping": {
                "renderRightItemRotation": 0.9
              }
            }
          ]
        }
      }
    }
  ]
}
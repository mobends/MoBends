{
  "formatVersion": 2,
  "@define": {
    "jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}},
    "walking": {"live": {"and": [{"not": ["animator.jumping"]}, {"not": ["entityIsStandingStill"]}]}}
  },
  "layers": [
    {
      "select": [
        {"when": "animator.jumping", "then": "jump"},
        {"when": "entityIsStandingStill", "then": "stand"},
        {"then": "walk"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/quadruped/rest.json"},
                "@damping": {
                  "leg1": 0.5,
                  "foreLeg1": 0.5,
                  "leg2": 0.5,
                  "foreLeg2": 0.5,
                  "leg3": 0.5,
                  "foreLeg3": 0.5,
                  "leg4": 0.5,
                  "foreLeg4": 0.5
                }
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/quadruped/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.09]}, "clipLength"]}
                },
                "@damping": {"head": 0.5, "body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "pre",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"},
                "@space": "post"
              }
            ]
          }
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/quadruped/walk.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@damping": {
                  "leg1": 0.8,
                  "foreLeg1": 0.8,
                  "leg2": 0.8,
                  "foreLeg2": 0.8,
                  "leg3": 0.8,
                  "foreLeg3": 0.8,
                  "leg4": 0.8,
                  "foreLeg4": 0.8
                }
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"},
                "@space": "post"
              }
            ]
          }
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/quadruped/jump.json"},
                "@damping": {
                  "leg1": 0.3,
                  "foreLeg1": 0.3,
                  "leg2": 0.3,
                  "foreLeg2": 0.3,
                  "leg3": 0.3,
                  "foreLeg3": 0.3,
                  "leg4": 0.3,
                  "foreLeg4": 0.3
                }
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"},
                "@space": "post"
              }
            ]
          }
        }
      }
    }
  ]
}

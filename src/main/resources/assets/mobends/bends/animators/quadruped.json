{
  "formatVersion": 2,
  "@define": {
    "jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}},
    "walking": {"live": {"and": [{"not": ["animator.jumping"]}, {"not": ["entityIsStandingStill"]}]}}
  },
  "layers": [
    {
      "select": [
        {"when": "animator.jumping", "then": "jump"},
        {"when": "entityIsStandingStill", "then": "stand"},
        {"then": "walk"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/quadruped/rest.json"},
                "@smoothing": {
                  "leg1": 2,
                  "foreLeg1": 2,
                  "leg2": 2,
                  "foreLeg2": 2,
                  "leg3": 2,
                  "foreLeg3": 2,
                  "leg4": 2,
                  "foreLeg4": 2
                }
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/quadruped/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.09]}, "clipLength"]}
                },
                "@smoothing": {"head": 2, "body": 2}
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "pre",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"}
            ]
          }
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/quadruped/walk.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@smoothing": {
                  "leg1": 1.25,
                  "foreLeg1": 1.25,
                  "leg2": 1.25,
                  "foreLeg2": 1.25,
                  "leg3": 1.25,
                  "foreLeg3": 1.25,
                  "leg4": 1.25,
                  "foreLeg4": 1.25
                }
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"}
            ]
          }
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/quadruped/jump.json"},
                "@smoothing": {
                  "leg1": 3.33,
                  "foreLeg1": 3.33,
                  "leg2": 3.33,
                  "foreLeg2": 3.33,
                  "leg3": 3.33,
                  "foreLeg3": 3.33,
                  "leg4": 3.33,
                  "foreLeg4": 3.33
                }
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"}
            ]
          }
        }
      }
    }
  ]
}

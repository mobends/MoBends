{
  "formatVersion": 2,
  "layers": [
    {
      "conditions": {
        "jumping": {
          "type": "core:or",
          "conditions": [
            {
              "type": "core:state",
              "state": "AIRBORNE"
            },
            {
              "type": "core:compare",
              "left": "ticksAfterTouchdown",
              "op": "<",
              "right": 1
            }
          ]
        }
      },
      "select": [
        {
          "when": "jumping",
          "then": "jump"
        },
        {
          "when": {
            "type": "core:state",
            "state": "STANDING_STILL"
          },
          "then": "stand"
        },
        {
          "then": "walk"
        }
      ],

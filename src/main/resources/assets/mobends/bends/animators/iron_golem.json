{
  "formatVersion": 2,
  "@define": {"inJump": {"state": false}, "climbing": {"state": false}},
  "layers": [
    {
      "@comment": "Golems wander at about 0.0496 blocks a tick, just under the MOVING_HORIZONTALLY dead zone (0.05), so the walk goes by the golem's own speed thresholds, apart to keep it from flickering. Between the two thresholds the selector chooses nothing, so the golem keeps standing or walking; landing between them, it walks (the airborne machine's connection).",
      "@define": {
        "walkStart": {"live": 0.02},
        "walkStop": {"live": 0.01},
        "jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}}
      },
      "select": [
        {"when": {"or": ["layer.jumping", "animator.climbing"]}, "then": "airborne"},
        {"when": {"ge": ["entityXZSpeed", "layer.walkStart"]}, "then": "walk"},
        {"when": {"lt": ["entityXZSpeed", "layer.walkStop"]}, "then": "stand"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/rest.json"},
                "@damping": {
                  "rightArm": 0.5,
                  "leftArm": 0.5,
                  "rightForeArm": 0.5,
                  "leftForeArm": 0.5,
                  "rightLeg": 0.5,
                  "leftLeg": 0.5,
                  "rightForeLeg": 0.5,
                  "leftForeLeg": 0.5
                }
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/iron_golem/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.07]}, "clipLength"]}
                },
                "@damping": {"head": 0.5, "body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "pre",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
              {
                "@when": {"gt": ["entity.attackTimer", 0]},
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/attack.json", "frame": "entity.attackTimer"},
                "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
              }
            ]
          },
          "@on": {"enter": [{"set": ["animator.inJump", false]}]}
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/rest.json"},
                "@damping": {
                  "rightArm": 0.5,
                  "leftArm": 0.5,
                  "rightForeArm": 0.5,
                  "leftForeArm": 0.5,
                  "rightLeg": 0.5,
                  "leftLeg": 0.5,
                  "rightForeLeg": 0.5,
                  "leftForeLeg": 0.5
                }
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "x", "angle": 0},
                "@space": "override",
                "@damping": {"body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
              {
                "@when": {"gt": ["entity.attackTimer", 0]},
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/attack.json", "frame": "entity.attackTimer"},
                "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
              }
            ]
          },
          "@on": {"enter": [{"set": ["animator.inJump", false]}]}
        }
      },
      "machines": {
        "airborne": {
          "@comment": "In the air, and climbing: a climb when it lifted off with a ledge ahead to climb onto (read once, as it leaves the ground), a jump otherwise. The climb outlasts the jump: the layer stays here while animator.climbing holds.",
          "@define": {"climb": {"constant": {"core:ledge_ahead": []}}},
          "select": [{"when": "machine.climb", "then": "climb"}, {"then": "jump"}],
          "nodes": {
            "jump": {
              "@comment": "As the player's: the push-off snaps the legs straight, then they bend slowly as it flies. The arms are heavy: pressed in and swung back while it rises, they flare out and swing forward as it falls, lagging the motion on springs, and the torso leans into the fall.",
              "core:pose": {
                "pose": [
                  {
                    "core:spring": {
                      "inout": "node.flare",
                      "target": {"clamp": [{"mul": ["entityInterpolatedMotionY", -70]}, -6, 35]},
                      "stiffness": 0.3,
                      "friction": 0.3
                    }
                  },
                  {
                    "core:spring": {
                      "inout": "node.swing",
                      "target": {"clamp": [{"mul": ["entityInterpolatedMotionY", 35]}, -20, 15]},
                      "stiffness": 0.25,
                      "friction": 0.3
                    }
                  },
                  {
                    "core:spring": {
                      "inout": "node.lean",
                      "target": {"clamp": [{"mul": ["entityInterpolatedMotionY", -15]}, -4, 8]},
                      "stiffness": 0.2,
                      "friction": 0.35
                    }
                  },
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/jump.json"},
                    "@damping": {"rightLeg": 0.15, "leftLeg": 0.15, "rightForeLeg": 0.12, "leftForeLeg": 0.12}
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/iron_golem/rest.json",
                      "bones": ["rightArm", "leftArm", "rightForeArm", "leftForeArm"]
                    },
                    "@damping": {"rightArm": 0.5, "leftArm": 0.5, "rightForeArm": 0.5, "leftForeArm": 0.5}
                  },
                  {
                    "core:axis_rotate": {"bone": "rightArm", "axis": "z", "angle": {"add": ["node.flare", 4]}},
                    "@space": "pre"
                  },
                  {
                    "core:axis_rotate": {"bone": "leftArm", "axis": "z", "angle": {"sub": [-4, "node.flare"]}},
                    "@space": "pre"
                  },
                  {"core:axis_rotate": {"bone": "rightArm", "axis": "x", "angle": "node.swing"}, "@space": "pre"},
                  {"core:axis_rotate": {"bone": "leftArm", "axis": "x", "angle": "node.swing"}, "@space": "pre"},
                  {
                    "core:axis_rotate": {"bone": "rightForeArm", "axis": "x", "angle": {"sub": [-8, {"mul": ["node.flare", 0.4]}]}},
                    "@space": "post"
                  },
                  {
                    "core:axis_rotate": {"bone": "leftForeArm", "axis": "x", "angle": {"sub": [-8, {"mul": ["node.flare", 0.4]}]}},
                    "@space": "post"
                  },
                  {
                    "core:axis_rotate": {"bone": "body", "axis": "x", "angle": "node.lean"},
                    "@space": "override",
                    "@damping": {"body": 0.5}
                  },
                  {
                    "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                    "@space": "override",
                    "@damping": {"head": 0.5}
                  },
                  {"core:axis_rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
                  {
                    "@when": {"gt": ["entity.attackTimer", 0]},
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/iron_golem/attack.json",
                      "frame": "entity.attackTimer"
                    },
                    "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
                  }
                ],
                "enterPose": [
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/iron_golem/rest.json",
                      "bones": ["rightLeg", "leftLeg", "rightForeLeg", "leftForeLeg"]
                    }
                  }
                ]
              },
              "@define": {"flare": {"state": 0}, "swing": {"state": 0}, "lean": {"state": 0}},
              "@on": {"enter": [{"set": ["animator.inJump", true]}]}
            },
            "climb": {
              "@comment": "Lifting off against a ledge (a block in front of its feet), it climbs onto it, slower than its own jump: core:anchor draws it where the climb has got to, in the coordinates of the block ahead (u into the block from its near face, h up from the ground; the block is taken in doubles, which a position far from the origin needs), while the entity itself is already up there. The arms swing up and slam the hands down on the top, well ahead; the arms are solved for that spot every frame (two bones, elbows back, the lean of the whole golem counted in), so they pull and then push, and stay straight, pushing, once the shoulders are out of reach. Reaching, it steps half a block in towards the block (closer than the entity can stand), then hauls itself up the face, leaning into it, the right knee comes up onto the top, then the left; the hands let go and the arms swing back on springs, overshooting and settling, heavy; it walks onto the middle of the block and is handed back to where it really is. It gives up, gliding back to the entity, if the entity gets far from where it is drawn (knocked away, or hurrying on once it is up: further than the climb's own lag, 1.6 blocks while it rises, 0.8 once it is up) or attacks. Lengths are in blocks, as ModelIronGolem has them: the shoulder above the feet, the middle of the golem (what centerRotation turns about), the upper arm (shoulder to elbow), the forearm (elbow to the hand's end).",
              "core:pose": {
                "pose": [
                  {
                    "core:anchor": {
                      "point": {
                        "x": {
                          "if": [
                            {"eq": ["node.dirX", 0]},
                            "entityWorldX",
                            {"add": ["node.blockX", {"toDouble": [{"if": [{"gt": ["node.dirX", 0]}, "node.u", {"sub": [1, "node.u"]}]}]}]}
                          ]
                        },
                        "y": {"add": ["node.blockY", {"toDouble": ["node.h"]}]},
                        "z": {
                          "if": [
                            {"eq": ["node.dirZ", 0]},
                            "entityWorldZ",
                            {"add": ["node.blockZ", {"toDouble": [{"if": [{"gt": ["node.dirZ", 0]}, "node.u", {"sub": [1, "node.u"]}]}]}]}
                          ]
                        }
                      },
                      "weight": {"sub": [1, {"smoothstep": ["nodeTicksElapsed", 15, 19]}]},
                      "out": {"positionDifference": "node.drift"}
                    }
                  },
                  {
                    "core:spring": {
                      "inout": "node.lean",
                      "target": {
                        "add": [
                          0,
                          {"mul": [8, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                          {"mul": [16, {"smoothstep": ["nodeTicksElapsed", 3, 8]}]},
                          {"mul": [-14, {"smoothstep": ["nodeTicksElapsed", 8, 12]}]},
                          {"mul": [-10, {"smoothstep": ["nodeTicksElapsed", 12, 15]}]}
                        ]
                      },
                      "stiffness": 0.25,
                      "friction": 0.35
                    }
                  },
                  {
                    "@when": "node.released",
                    "core:spring": {
                      "inout": "node.armX",
                      "target": {"add": [30, {"mul": [-30, {"smoothstep": ["nodeTicksElapsed", 10, 15]}]}]},
                      "stiffness": 0.2,
                      "friction": 0.25
                    }
                  },
                  {
                    "@when": "node.released",
                    "core:spring": {"inout": "node.foreX", "target": -6, "stiffness": 0.2, "friction": 0.3}
                  },
                  {
                    "core:axis_rotate": {"bone": "centerRotation", "axis": "x", "angle": "node.lean"},
                    "@space": "override",
                    "@damping": {"centerRotation": 0.8}
                  },
                  {
                    "core:axis_rotate": {
                      "bone": "rightLeg",
                      "axis": "x",
                      "angle": {
                        "add": [
                          0,
                          {"mul": [-20, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                          {"mul": [-80, {"smoothstep": ["nodeTicksElapsed", 3, 7]}]},
                          {"mul": [40, {"smoothstep": ["nodeTicksElapsed", 7, 10]}]},
                          {"mul": [45, {"smoothstep": ["nodeTicksElapsed", 10, 13]}]},
                          {"mul": [15, {"smoothstep": ["nodeTicksElapsed", 13, 16]}]}
                        ]
                      }
                    },
                    "@space": "override",
                    "@damping": {"rightLeg": 0.6}
                  },
                  {
                    "core:axis_rotate": {
                      "bone": "rightForeLeg",
                      "axis": "x",
                      "angle": {
                        "add": [
                          0,
                          {"mul": [30, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                          {"mul": [80, {"smoothstep": ["nodeTicksElapsed", 3, 7]}]},
                          {"mul": [-40, {"smoothstep": ["nodeTicksElapsed", 7, 10]}]},
                          {"mul": [-50, {"smoothstep": ["nodeTicksElapsed", 10, 13]}]},
                          {"mul": [-20, {"smoothstep": ["nodeTicksElapsed", 13, 16]}]}
                        ]
                      }
                    },
                    "@space": "override",
                    "@damping": {"rightForeLeg": 0.6}
                  },
                  {
                    "core:axis_rotate": {
                      "bone": "leftLeg",
                      "axis": "x",
                      "angle": {
                        "add": [
                          0,
                          {"mul": [-10, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                          {"mul": [25, {"smoothstep": ["nodeTicksElapsed", 3, 7]}]},
                          {"mul": [-85, {"smoothstep": ["nodeTicksElapsed", 7, 10]}]},
                          {"mul": [30, {"smoothstep": ["nodeTicksElapsed", 10, 13]}]},
                          {"mul": [40, {"smoothstep": ["nodeTicksElapsed", 13, 16]}]}
                        ]
                      }
                    },
                    "@space": "override",
                    "@damping": {"leftLeg": 0.6}
                  },
                  {
                    "core:axis_rotate": {
                      "bone": "leftForeLeg",
                      "axis": "x",
                      "angle": {
                        "add": [
                          0,
                          {"mul": [15, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                          {"mul": [-5, {"smoothstep": ["nodeTicksElapsed", 3, 7]}]},
                          {"mul": [90, {"smoothstep": ["nodeTicksElapsed", 7, 10]}]},
                          {"mul": [-50, {"smoothstep": ["nodeTicksElapsed", 10, 13]}]},
                          {"mul": [-50, {"smoothstep": ["nodeTicksElapsed", 13, 16]}]}
                        ]
                      }
                    },
                    "@space": "override",
                    "@damping": {"leftForeLeg": 0.6}
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/iron_golem/rest.json",
                      "bones": ["rightArm", "leftArm", "rightForeArm", "leftForeArm"]
                    },
                    "@damping": {"rightArm": 0.6, "leftArm": 0.6, "rightForeArm": 0.6, "leftForeArm": 0.6}
                  },
                  {"core:axis_rotate": {"bone": "rightArm", "axis": "x", "angle": "node.armX"}, "@space": "pre"},
                  {"core:axis_rotate": {"bone": "leftArm", "axis": "x", "angle": "node.armX"}, "@space": "pre"},
                  {"core:axis_rotate": {"bone": "rightArm", "axis": "z", "angle": 4}, "@space": "pre"},
                  {"core:axis_rotate": {"bone": "leftArm", "axis": "z", "angle": -4}, "@space": "pre"},
                  {
                    "core:axis_rotate": {"bone": "rightForeArm", "axis": "x", "angle": "node.foreX"},
                    "@space": "post"
                  },
                  {
                    "core:axis_rotate": {"bone": "leftForeArm", "axis": "x", "angle": "node.foreX"},
                    "@space": "post"
                  },
                  {
                    "core:axis_rotate": {"bone": "body", "axis": "x", "angle": 0},
                    "@space": "override",
                    "@damping": {"body": 0.5}
                  },
                  {
                    "core:axis_rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                    "@space": "override",
                    "@damping": {"head": 0.5}
                  },
                  {
                    "core:axis_rotate": {
                      "bone": "head",
                      "axis": "x",
                      "angle": {
                        "add": [
                          "entityHeadPitch",
                          {
                            "add": [
                              0,
                              {"mul": [25, {"smoothstep": ["nodeTicksElapsed", 0, 3]}]},
                              {"mul": [-15, {"smoothstep": ["nodeTicksElapsed", 3, 10]}]},
                              {"mul": [-10, {"smoothstep": ["nodeTicksElapsed", 10, 14]}]}
                            ]
                          }
                        ]
                      }
                    },
                    "@space": "post"
                  }
                ]
              },
              "@define": {
                "shoulderHeight": {"constant": 1.9375},
                "middle": {"constant": 1.35},
                "upperArm": {"constant": 0.78125},
                "foreArm": {"constant": 0.9375},
                "yaw": {"constant": {"mul": ["entityBodyYaw", 0.0174533]}},
                "dirX": {
                  "constant": {
                    "if": [
                      {"gt": [{"abs": [{"sin": ["node.yaw"]}]}, {"abs": [{"cos": ["node.yaw"]}]}]},
                      {"if": [{"gt": [{"neg": [{"sin": ["node.yaw"]}]}, 0]}, 1, -1]},
                      0
                    ]
                  }
                },
                "dirZ": {
                  "constant": {"if": [{"eq": ["node.dirX", 0]}, {"if": [{"gt": [{"cos": ["node.yaw"]}, 0]}, 1, -1]}, 0]}
                },
                "blockX": {"constant": {"add": [{"floor": ["entityWorldX"]}, {"toDouble": ["node.dirX"]}]}},
                "blockY": {"constant": {"floor": ["entityWorldY"]}},
                "blockZ": {"constant": {"add": [{"floor": ["entityWorldZ"]}, {"toDouble": ["node.dirZ"]}]}},
                "startU": {
                  "constant": {
                    "sub": [
                      {
                        "add": [
                          {"mul": [{"toFloat": [{"sub": ["entityWorldX", "node.blockX"]}]}, "node.dirX"]},
                          {"mul": [{"toFloat": [{"sub": ["entityWorldZ", "node.blockZ"]}]}, "node.dirZ"]}
                        ]
                      },
                      {"if": [{"gt": [{"add": ["node.dirX", "node.dirZ"]}, 0]}, 0, -1]}
                    ]
                  }
                },
                "u": {
                  "live": {
                    "add": [
                      "node.startU",
                      {
                        "mul": [
                          {"sub": [{"add": ["node.startU", 0.5]}, "node.startU"]},
                          {"smoothstep": ["nodeTicksElapsed", 0, 3]}
                        ]
                      },
                      {
                        "mul": [
                          {"sub": [{"add": ["node.startU", 0.55]}, {"add": ["node.startU", 0.5]}]},
                          {"smoothstep": ["nodeTicksElapsed", 3, 9]}
                        ]
                      },
                      {
                        "mul": [
                          {"sub": [{"add": ["node.startU", 0.85]}, {"add": ["node.startU", 0.55]}]},
                          {"smoothstep": ["nodeTicksElapsed", 9, 12]}
                        ]
                      },
                      {
                        "mul": [
                          {"sub": [0.5, {"add": ["node.startU", 0.85]}]},
                          {"smoothstep": ["nodeTicksElapsed", 12, 17]}
                        ]
                      }
                    ]
                  }
                },
                "h": {
                  "live": {
                    "add": [
                      0,
                      {"mul": [0.05, {"smoothstep": ["nodeTicksElapsed", 0, 4]}]},
                      {"mul": [0.95, {"smoothstep": ["nodeTicksElapsed", 4, 11]}]}
                    ]
                  }
                },
                "handU": {"constant": 0.6},
                "leanRad": {"live": {"mul": ["node.lean", 0.0174533]}},
                "shoulderU": {
                  "live": {
                    "add": [
                      "node.u",
                      {"mul": [{"sub": ["node.shoulderHeight", "node.middle"]}, {"sin": ["node.leanRad"]}]}
                    ]
                  }
                },
                "shoulderH": {
                  "live": {
                    "add": [
                      "node.h",
                      "node.middle",
                      {"mul": [{"sub": ["node.shoulderHeight", "node.middle"]}, {"cos": ["node.leanRad"]}]}
                    ]
                  }
                },
                "handAhead": {"live": {"sub": ["node.handU", "node.shoulderU"]}},
                "handBelow": {"live": {"sub": ["node.shoulderH", 1]}},
                "handDistance": {
                  "live": {
                    "sqrt": [
                      {
                        "add": [
                          {"mul": ["node.handAhead", "node.handAhead"]},
                          {"mul": ["node.handBelow", "node.handBelow"]}
                        ]
                      }
                    ]
                  }
                },
                "armReach": {
                  "live": {"min": ["node.handDistance", {"mul": [0.999, {"add": ["node.upperArm", "node.foreArm"]}]}]}
                },
                "elbowCos": {
                  "live": {
                    "clamp": [
                      {
                        "div": [
                          {
                            "sub": [
                              {
                                "add": [
                                  {"mul": ["node.upperArm", "node.upperArm"]},
                                  {"mul": ["node.foreArm", "node.foreArm"]}
                                ]
                              },
                              {"mul": ["node.armReach", "node.armReach"]}
                            ]
                          },
                          {"mul": [2, "node.upperArm", "node.foreArm"]}
                        ]
                      },
                      -1,
                      1
                    ]
                  }
                },
                "shoulderCos": {
                  "live": {
                    "clamp": [
                      {
                        "div": [
                          {
                            "add": [
                              {
                                "sub": [
                                  {"mul": ["node.upperArm", "node.upperArm"]},
                                  {"mul": ["node.foreArm", "node.foreArm"]}
                                ]
                              },
                              {"mul": ["node.armReach", "node.armReach"]}
                            ]
                          },
                          {"mul": [2, "node.upperArm", "node.armReach"]}
                        ]
                      },
                      -1,
                      1
                    ]
                  }
                },
                "plantArm": {
                  "live": {
                    "sub": [
                      {
                        "mul": [
                          57.29578,
                          {
                            "atan2": [
                              {"sqrt": [{"sub": [1, {"mul": ["node.shoulderCos", "node.shoulderCos"]}]}]},
                              "node.shoulderCos"
                            ]
                          }
                        ]
                      },
                      {"sub": [{"mul": [57.29578, {"atan2": ["node.handAhead", "node.handBelow"]}]}, "node.lean"]}
                    ]
                  }
                },
                "plantForeArm": {
                  "live": {
                    "sub": [
                      {
                        "mul": [
                          57.29578,
                          {
                            "atan2": [
                              {"sqrt": [{"sub": [1, {"mul": ["node.elbowCos", "node.elbowCos"]}]}]},
                              "node.elbowCos"
                            ]
                          }
                        ]
                      },
                      180
                    ]
                  }
                },
                "grip": {"live": {"smoothstep": ["nodeTicksElapsed", 1, 4]}},
                "drift": {"state": 0},
                "released": {"state": false},
                "armX": {"state": 0},
                "foreX": {"state": 0},
                "lean": {"state": 0}
              },
              "@on": {
                "enter": [{"set": ["animator.inJump", true]}, {"set": ["animator.climbing", true]}],
                "update": [
                  {"@when": {"ge": ["nodeTicksElapsed", 10]}, "set": ["node.released", true]},
                  {
                    "@when": {"not": ["node.released"]},
                    "set": ["node.armX", {"sub": ["node.plantArm", {"mul": [35, {"sub": [1, "node.grip"]}]}]}]
                  },
                  {
                    "@when": {"not": ["node.released"]},
                    "set": [
                      "node.foreX",
                      {
                        "add": [{"mul": ["node.plantForeArm", "node.grip"]}, {"mul": [-10, {"sub": [1, "node.grip"]}]}]
                      }
                    ]
                  },
                  {
                    "@when": {
                      "or": [
                        {"ge": ["nodeTicksElapsed", 19]},
                        {"gt": ["node.drift", {"if": [{"gt": ["nodeTicksElapsed", 9]}, 0.8, 1.6]}]},
                        {"gt": ["entity.attackTimer", 0]}
                      ]
                    },
                    "set": ["animator.climbing", false]
                  }
                ]
              }
            }
          },
          "@connections": [
            {
              "when": {
                "and": [
                  {"not": ["animator.climbing"]},
                  {"not": ["layer.jumping"]},
                  {"ge": ["entityXZSpeed", "layer.walkStop"]}
                ]
              },
              "then": "walk"
            }
          ]
        }
      }
    },
    {
      "@comment": "The golem stands and walks on its feet: step_turn plants them in the world, turns the body only as far as they have stepped (the leg on the side of the turn first) and, walking, steps the foot left behind to where the body will be, shifting and rolling the weight over the planted one. It is off while the golem jumps, given up within two ticks of liftoff so the jump's push-off shows. Vanilla rocks the whole golem side to side while it walks (RenderIronGolem.applyRotations: 6.5° on a triangle wave of the limb swing, while limbSwingAmount >= 0.01); the render rotation turns it back first. The upper body reacts, as much as it stands on its feet: the torso leads a turn, the arms lag behind it, swing against the legs and out when a foot lands, the head keeps looking where the golem looks. Landing, the whole golem gives under its weight (a kick on a spring): it sinks, the knees and elbows bend, the arms swing out, the torso and head nod. Not while climbing, whose anchor holds the whole model where it is drawn and leans it; after a climb, the whole model glides back to the entity, upright.",
      "defaultOnEntry": "planted",
      "nodes": {
        "planted": {
          "core:pose": {
            "pose": [
              {
                "core:accumulate": {"inout": "node.onFeet", "rate": {"if": ["animator.inJump", -0.5, 0.15]}, "min": 0, "max": 1}
              },
              {"core:accumulate": {"inout": "node.landing", "rate": -0.25, "min": 0, "max": 1}},
              {
                "core:spring": {"inout": "node.landKick", "target": "node.landing", "stiffness": 0.3, "friction": 0.35}
              },
              {
                "core:axis_rotate": {"bone": "renderRotation", "axis": "z", "angle": "node.vanillaRock"},
                "@space": "override",
                "@snap": true
              },
              {
                "core:step_turn": {
                  "weight": "node.onFeet",
                  "legs": [
                    {
                      "upper": "leftLeg",
                      "lower": "leftForeLeg",
                      "hip": [-4, 11, 0],
                      "knee": [0, 5, -3],
                      "foot": [-0.5, 8, 2.5]
                    },
                    {
                      "upper": "rightLeg",
                      "lower": "rightForeLeg",
                      "hip": [5, 11, 0],
                      "knee": [0, 5, -3],
                      "foot": [-0.5, 8, 2.5]
                    }
                  ],
                  "turnThreshold": 15,
                  "maxStepAngle": 45,
                  "stepDuration": 9,
                  "stepHeight": 3.5,
                  "stepPause": 2,
                  "strideLength": 14,
                  "minStepDuration": 4,
                  "finishDrift": 0.5,
                  "settleAngle": 3,
                  "bodyStiffness": 0.12,
                  "bodyDamping": 0.55,
                  "runSpeed": 0.09,
                  "runBodyStiffness": 1,
                  "runBodyDamping": 2,
                  "runStrideLength": 24,
                  "runStepHeight": 5,
                  "runFacingSmoothing": 4,
                  "crouch": 0.5,
                  "walkCrouch": 2,
                  "impactDepth": 1.5,
                  "impactTime": 2.5,
                  "weightShift": 1,
                  "weightRoll": 3,
                  "out": {
                    "turnLag": "node.turnLag",
                    "turnSpeed": "node.turnSpeed",
                    "stepLift": "node.stepLift",
                    "stepImpact": "node.stepImpact",
                    "stride": "node.stride"
                  }
                }
              },
              {
                "core:spring": {"inout": "node.armLag", "target": "node.turnSpeed", "stiffness": 0.12, "friction": 0.3}
              },
              {
                "core:spring": {"inout": "node.armSway", "target": "node.stepLift", "stiffness": 0.15, "friction": 0.35}
              },
              {
                "core:spring": {"inout": "node.jolt", "target": "node.stepImpact", "stiffness": 0.35, "friction": 0.6}
              },
              {
                "core:spring": {"inout": "node.armSwing", "target": "node.stride", "stiffness": 0.1, "friction": 0.25}
              },
              {
                "core:axis_rotate": {
                  "bone": "head",
                  "axis": "y",
                  "angle": {"sub": [{"clamp": [{"add": ["entityHeadYaw", "node.turnLag"]}, -85, 85]}, "entityHeadYaw"]}
                },
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": {"mul": [{"mul": ["node.jolt", 4]}, "node.onFeet"]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "x", "angle": {"mul": [{"mul": ["node.jolt", 2]}, "node.onFeet"]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "y", "angle": {"mul": ["node.twist", "node.onFeet"]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {
                  "bone": "rightArm",
                  "axis": "x",
                  "angle": {"mul": [{"mul": ["node.armLag", -2.5]}, "node.onFeet"]}
                },
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "x", "angle": {"mul": [{"mul": ["node.armLag", 2.5]}, "node.onFeet"]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {
                  "bone": "rightArm",
                  "axis": "z",
                  "angle": {"mul": [{"add": [{"mul": ["node.jolt", 5]}, {"mul": ["node.armSway", -4]}]}, "node.onFeet"]}
                },
                "@space": "pre"
              },
              {
                "core:axis_rotate": {
                  "bone": "leftArm",
                  "axis": "z",
                  "angle": {"mul": [{"add": [{"mul": ["node.jolt", -5]}, {"mul": ["node.armSway", -4]}]}, "node.onFeet"]}
                },
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "y", "angle": {"mul": ["node.twist", "node.onFeet"]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "y", "angle": {"mul": ["node.twist", "node.onFeet"]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {
                  "bone": "rightForeArm",
                  "axis": "x",
                  "angle": {"mul": [{"mul": ["node.jolt", -12]}, "node.onFeet"]}
                },
                "@space": "post"
              },
              {
                "core:axis_rotate": {
                  "bone": "leftForeArm",
                  "axis": "x",
                  "angle": {"mul": [{"mul": ["node.jolt", -12]}, "node.onFeet"]}
                },
                "@space": "post"
              },
              {
                "core:axis_rotate": {
                  "bone": "leftArm",
                  "axis": "x",
                  "angle": {"mul": [{"mul": ["node.armSwing", 3.5]}, "node.onFeet"]}
                },
                "@space": "pre"
              },
              {
                "core:axis_rotate": {
                  "bone": "rightArm",
                  "axis": "x",
                  "angle": {"mul": [{"mul": ["node.armSwing", -3.5]}, "node.onFeet"]}
                },
                "@space": "pre"
              },
              {
                "@when": {"not": ["animator.climbing"]},
                "core:axis_rotate": {"bone": "centerRotation", "axis": "x", "angle": 0},
                "@space": "override",
                "@damping": {"centerRotation": 0.3}
              },
              {
                "@when": {"not": ["animator.climbing"]},
                "core:vector": {"bone": "root", "x": 0, "y": {"mul": ["node.landKick", -1.5]}, "z": 0},
                "@damping": {"root": [0.2, null, 0.2]}
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "x", "angle": {"mul": ["node.landKick", 5]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "x", "angle": {"mul": ["node.landKick", 6]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "z", "angle": {"mul": ["node.landKick", 6]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "z", "angle": {"mul": ["node.landKick", -6]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "x", "angle": {"mul": ["node.landKick", -14]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "x", "angle": {"mul": ["node.landKick", -14]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "rightLeg", "axis": "x", "angle": {"mul": ["node.landKick", -18]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "leftLeg", "axis": "x", "angle": {"mul": ["node.landKick", -18]}},
                "@space": "pre"
              },
              {
                "core:axis_rotate": {"bone": "rightForeLeg", "axis": "x", "angle": {"mul": ["node.landKick", 30]}},
                "@space": "post"
              },
              {
                "core:axis_rotate": {"bone": "leftForeLeg", "axis": "x", "angle": {"mul": ["node.landKick", 30]}},
                "@space": "post"
              }
            ]
          },
          "@define": {
            "onFeet": {"state": 0},
            "turnLag": {"state": 0},
            "turnSpeed": {"state": 0},
            "stepLift": {"state": 0},
            "stepImpact": {"state": 0},
            "stride": {"state": 0},
            "armLag": {"state": 0},
            "armSway": {"state": 0},
            "jolt": {"state": 0},
            "armSwing": {"state": 0},
            "twist": {"live": {"clamp": [{"mul": ["node.turnLag", 0.3]}, -12, 12]}},
            "vanillaRock": {
              "live": {
                "mul": [
                  6.5,
                  {
                    "div": [
                      {"sub": [{"abs": [{"sub": [{"mod": [{"add": ["entityLimbSwing", 6]}, 13]}, 6.5]}]}, 3.25]},
                      3.25
                    ]
                  },
                  {"clamp": [{"floor": [{"mul": ["entity.rawLimbSwingAmount", 100]}]}, 0, 1]}
                ]
              }
            },
            "landing": {"state": 0},
            "landKick": {"state": 0}
          },
          "@on": {
            "update": [
              {
                "@when": {"and": [{"decreased": ["entityTicksAfterTouchdown"]}, {"not": ["animator.climbing"]}]},
                "set": ["node.landing", 1]
              }
            ]
          }
        }
      }
    }
  ]
}

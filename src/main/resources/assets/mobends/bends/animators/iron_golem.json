{
  "formatVersion": 2,
  "@define": {"inJump": {"state": false}},
  "layers": [
    {
      "@comment": "Golems wander at about 0.0496 blocks a tick, just under the MOVING_HORIZONTALLY dead zone (0.05), so the walk goes by the golem's own speed thresholds, apart to keep it from flickering. Between the two thresholds the selector chooses nothing, so the golem keeps standing or walking; landing between them, it walks (the jump's connection).",
      "@define": {
        "walkStart": {"live": 0.02},
        "walkStop": {"live": 0.01},
        "jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}}
      },
      "select": [
        {"when": "layer.jumping", "then": "jump"},
        {"when": {"ge": ["entityXZSpeed", "layer.walkStart"]}, "then": "walk"},
        {"when": {"lt": ["entityXZSpeed", "layer.walkStop"]}, "then": "stand"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/rest.json"},
                "@damping": {
                  "rightArm": 0.5,
                  "leftArm": 0.5,
                  "rightForeArm": 0.5,
                  "leftForeArm": 0.5,
                  "rightLeg": 0.5,
                  "leftLeg": 0.5,
                  "rightForeLeg": 0.5,
                  "leftForeLeg": 0.5
                }
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/iron_golem/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.07]}, "clipLength"]}
                },
                "@damping": {"head": 0.5, "body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "PRE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"}, "@space": "POST"},
              {
                "@when": {"gt": ["entity.attackTimer", 0]},
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/attack.json", "frame": "entity.attackTimer"},
                "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
              }
            ]
          },
          "@on": {"enter": [{"set": ["animator.inJump", false]}]}
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/rest.json"},
                "@damping": {
                  "rightArm": 0.5,
                  "leftArm": 0.5,
                  "rightForeArm": 0.5,
                  "leftForeArm": 0.5,
                  "rightLeg": 0.5,
                  "leftLeg": 0.5,
                  "rightForeLeg": 0.5,
                  "leftForeLeg": 0.5
                }
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "X", "angle": 0},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"}, "@space": "POST"},
              {
                "@when": {"gt": ["entity.attackTimer", 0]},
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/attack.json", "frame": "entity.attackTimer"},
                "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
              }
            ]
          },
          "@on": {"enter": [{"set": ["animator.inJump", false]}]}
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/jump.json"},
                "@damping": {"rightLeg": 0.8, "leftLeg": 0.8, "rightForeLeg": 0.6, "leftForeLeg": 0.6}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/iron_golem/rest.json",
                  "bones": ["rightArm", "leftArm", "rightForeArm", "leftForeArm"]
                },
                "@damping": {"rightArm": 0.5, "leftArm": 0.5, "rightForeArm": 0.5, "leftForeArm": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "X", "angle": 0},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"}, "@space": "POST"},
              {
                "@when": {"gt": ["entity.attackTimer", 0]},
                "core:clip": {"animationKey": "mobends:bends/animations/iron_golem/attack.json", "frame": "entity.attackTimer"},
                "@damping": {"rightArm": 0.8, "leftArm": 0.8, "rightForeArm": 0.6, "leftForeArm": 0.6}
              }
            ]
          },
          "@on": {"enter": [{"set": ["animator.inJump", true]}]},
          "@connections": [
            {
              "when": {"and": [{"not": ["layer.jumping"]}, {"ge": ["entityXZSpeed", "layer.walkStop"]}]},
              "then": "walk"
            }
          ]
        }
      }
    },
    {
      "@comment": "The golem stands and walks on its feet: step_turn plants them in the world, turns the body only as far as they have stepped (the leg on the side of the turn first) and, walking, steps the foot left behind to where the body will be, shifting and rolling the weight over the planted one. It is off while the golem jumps. Vanilla rocks the whole golem side to side while it walks (RenderIronGolem.applyRotations: 6.5° on a triangle wave of the limb swing, while limbSwingAmount >= 0.01); the render rotation turns it back first. The upper body reacts: the torso leads a turn, the arms lag behind it, swing against the legs and out when a foot lands, the head keeps looking where the golem looks.",
      "defaultOnEntry": "planted",
      "nodes": {
        "planted": {
          "core:pose": {
            "pose": [
              {
                "core:accumulate": {"inout": "node.onFeet", "rate": {"if": ["animator.inJump", -0.15, 0.15]}, "min": 0, "max": 1}
              },
              {
                "core:axis_rotate": {"bone": "renderRotation", "axis": "Z", "angle": "node.vanillaRock"},
                "@space": "OVERRIDE",
                "@snap": true
              },
              {
                "core:step_turn": {
                  "weight": "node.onFeet",
                  "legs": [
                    {
                      "upper": "leftLeg",
                      "lower": "leftForeLeg",
                      "hip": [-4, 11, 0],
                      "knee": [0, 5, -3],
                      "foot": [-0.5, 8, 2.5]
                    },
                    {
                      "upper": "rightLeg",
                      "lower": "rightForeLeg",
                      "hip": [5, 11, 0],
                      "knee": [0, 5, -3],
                      "foot": [-0.5, 8, 2.5]
                    }
                  ],
                  "turnThreshold": 15,
                  "maxStepAngle": 45,
                  "stepDuration": 9,
                  "stepHeight": 3.5,
                  "stepPause": 2,
                  "strideLength": 14,
                  "minStepDuration": 4,
                  "finishDrift": 0.5,
                  "settleAngle": 3,
                  "bodyStiffness": 0.12,
                  "bodyDamping": 0.55,
                  "runSpeed": 0.09,
                  "runBodyStiffness": 1,
                  "runBodyDamping": 2,
                  "runStrideLength": 24,
                  "runStepHeight": 5,
                  "runFacingSmoothing": 4,
                  "crouch": 0.5,
                  "walkCrouch": 2,
                  "impactDepth": 1.5,
                  "impactTime": 2.5,
                  "weightShift": 1,
                  "weightRoll": 3,
                  "out": {
                    "turnLag": "node.turnLag",
                    "turnSpeed": "node.turnSpeed",
                    "stepLift": "node.stepLift",
                    "stepImpact": "node.stepImpact",
                    "stride": "node.stride"
                  }
                }
              },
              {
                "core:spring": {"inout": "node.armLag", "target": "node.turnSpeed", "stiffness": 0.12, "friction": 0.3}
              },
              {
                "core:spring": {"inout": "node.armSway", "target": "node.stepLift", "stiffness": 0.15, "friction": 0.35}
              },
              {
                "core:spring": {"inout": "node.jolt", "target": "node.stepImpact", "stiffness": 0.35, "friction": 0.6}
              },
              {
                "core:spring": {"inout": "node.armSwing", "target": "node.stride", "stiffness": 0.1, "friction": 0.25}
              },
              {
                "core:axis_rotate": {
                  "bone": "head",
                  "axis": "Y",
                  "angle": {"sub": [{"clamp": [{"add": ["entityHeadYaw", "node.turnLag"]}, -85, 85]}, "entityHeadYaw"]}
                },
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": {"mul": ["node.jolt", 4]}},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "X", "angle": {"mul": ["node.jolt", 2]}},
                "@space": "POST"
              },
              {"core:axis_rotate": {"bone": "body", "axis": "Y", "angle": "node.twist"}, "@space": "PRE"},
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "X", "angle": {"mul": ["node.armLag", -2.5]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "X", "angle": {"mul": ["node.armLag", 2.5]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {
                  "bone": "rightArm",
                  "axis": "Z",
                  "angle": {"add": [{"mul": ["node.jolt", 5]}, {"mul": ["node.armSway", -4]}]}
                },
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {
                  "bone": "leftArm",
                  "axis": "Z",
                  "angle": {"add": [{"mul": ["node.jolt", -5]}, {"mul": ["node.armSway", -4]}]}
                },
                "@space": "PRE"
              },
              {"core:axis_rotate": {"bone": "rightArm", "axis": "Y", "angle": "node.twist"}, "@space": "PRE"},
              {"core:axis_rotate": {"bone": "leftArm", "axis": "Y", "angle": "node.twist"}, "@space": "PRE"},
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": {"mul": ["node.jolt", -12]}},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "X", "angle": {"mul": ["node.jolt", -12]}},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "X", "angle": {"mul": ["node.armSwing", 3.5]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "X", "angle": {"mul": ["node.armSwing", -3.5]}},
                "@space": "PRE"
              }
            ]
          },
          "@define": {
            "onFeet": {"state": 0},
            "turnLag": {"state": 0},
            "turnSpeed": {"state": 0},
            "stepLift": {"state": 0},
            "stepImpact": {"state": 0},
            "stride": {"state": 0},
            "armLag": {"state": 0},
            "armSway": {"state": 0},
            "jolt": {"state": 0},
            "armSwing": {"state": 0},
            "twist": {"live": {"clamp": [{"mul": ["node.turnLag", 0.3]}, -12, 12]}},
            "vanillaRock": {
              "live": {
                "mul": [
                  6.5,
                  {
                    "div": [
                      {"sub": [{"abs": [{"sub": [{"mod": [{"add": ["entityLimbSwing", 6]}, 13]}, 6.5]}]}, 3.25]},
                      3.25
                    ]
                  },
                  {"clamp": [{"floor": [{"mul": ["entity.rawLimbSwingAmount", 100]}]}, 0, 1]}
                ]
              }
            }
          }
        }
      }
    }
  ]
}

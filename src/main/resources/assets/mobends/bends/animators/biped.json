{
  "formatVersion": 2,
  "layers": [
    {
      "@define": {
        "jumping": {"live": {"or": ["AIRBORNE", {"lt": ["ticksAfterTouchdown", 1]}]}},
        "bounced": {"live": {"and": [{"lt": ["prevMotionY", 0]}, {"gt": ["motionY", 0]}]}}
      },
      "select": [
        {"when": "layer.jumping", "then": "jump"},
        {"when": "STANDING_STILL", "then": "stand"},
        {"then": "walk"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/stand.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.1]}, "clipLength"]}
                },
                "@damping": {
                  "root": 0.6,
                  "localOffset": 0.3,
                  "renderRotation": 0.6,
                  "centerRotation": 0.3,
                  "renderRightItemRotation": 0.3,
                  "renderLeftItemRotation": 0.3,
                  "body": 1,
                  "rightArm": 0.4,
                  "leftArm": 0.4
                },
                "@vectorModes": {"root": "SLIDE", "localOffset": "SLIDE"}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"}, "@space": "PRE"},
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "@when": {"lt": ["ticksAfterTouchdown", 6.666666666666667]},
                "core:clip": {"animationKey": "mobends:bends/animations/biped/kneel.json", "frame": "ticksAfterTouchdown"},
                "@damping": {"body": 1},
                "@vectorModes": {"root": "SNAP"}
              }
            ],
            "enterPose": [
              {
                "@when": {"lt": ["ticksAfterTouchdown", 3.3333333333333335]},
                "core:clip": {"animationKey": "mobends:bends/animations/biped/stand_enter.json"}
              }
            ]
          },
          "@tags": ["stand"]
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/walk_base.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {
                  "root": [0.6, 1.2, 0.6],
                  "localOffset": 0.3,
                  "renderRotation": 0.6,
                  "centerRotation": 0.3,
                  "renderRightItemRotation": 0.3,
                  "renderLeftItemRotation": 0.3,
                  "body": 0.5,
                  "head": 0.5,
                  "rightArm": 0.8,
                  "leftArm": 0.8,
                  "rightForeArm": 0.8,
                  "leftForeArm": 0.8,
                  "rightLeg": 1,
                  "leftLeg": 1
                },
                "@vectorModes": {"root": "RETARGET", "localOffset": "SLIDE"}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/walk_forelegs.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {"leftForeLeg": 0.5, "rightForeLeg": 0.5}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/walk_swing.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]},
                  "weight": "limbSwingAmount"
                },
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "body", "axis": "Z", "angle": {"clamp": [{"mul": ["headYaw", -0.1]}, -10, 10]}},
                "@space": "PRE"
              },
              {"core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"}, "@space": "PRE"},
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "@when": {"lt": ["ticksAfterTouchdown", 6.666666666666667]},
                "core:clip": {"animationKey": "mobends:bends/animations/biped/kneel.json", "frame": "ticksAfterTouchdown"},
                "@damping": {"body": 1},
                "@vectorModes": {"root": "SNAP"}
              }
            ]
          },
          "@tags": ["walk"]
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/biped/jump.json", "frame": "ticksInAir"},
                "@damping": {
                  "root": 0.6,
                  "localOffset": 0.3,
                  "renderRotation": 0.6,
                  "centerRotation": 0.7,
                  "renderRightItemRotation": 0.3,
                  "renderLeftItemRotation": 0.3,
                  "body": 0.2,
                  "rightArm": 0.05,
                  "leftArm": 0.05,
                  "rightForeArm": 0.3,
                  "leftForeArm": 0.3
                },
                "@vectorModes": {"root": "SLIDE"}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"}, "@space": "PRE"},
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "@when": "MOVING_HORIZONTALLY",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/jump_moving_base.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {"rightLeg": 1, "leftLeg": 1, "leftForeArm": 0.3, "rightForeArm": 0.3}
              },
              {
                "@when": "MOVING_HORIZONTALLY",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/jump_moving_forelegs.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {"leftForeLeg": 0.3, "rightForeLeg": 0.3}
              },
              {
                "@when": "MOVING_HORIZONTALLY",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/biped/jump_moving_swing.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]},
                  "weight": "limbSwingAmount"
                },
                "@space": "POST"
              },
              {
                "@when": "STANDING_STILL",
                "core:clip": {"animationKey": "mobends:bends/animations/biped/jump_still.json"},
                "@damping": {"rightLeg": 0.3, "leftLeg": 0.3, "rightForeLeg": 0.3, "leftForeLeg": 0.3}
              }
            ],
            "enterPose": [{"core:clip": {"animationKey": "mobends:bends/animations/biped/jump_enter.json"}}]
          },
          "@connections": [{"when": "layer.bounced", "then": "jump"}],
          "@tags": ["jump"]
        }
      }
    }
  ]
}

{
  "formatVersion": 2,
  "@define": {"jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}}},
  "layers": [
    {
      "select": [
        {"when": "animator.jumping", "then": "jump"},
        {"when": "entityIsStandingStill", "then": "stand"},
        {"then": "walk"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/rest.json"},
                "@smoothing": {"rightLeg": 2, "foreRightLeg": 2, "leftLeg": 2, "foreLeftLeg": 2}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.09]}, "clipLength"]}
                },
                "@smoothing": {"head": 2}
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "pre",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
              {
                "core:rotate": {"bone": "rightWing", "axis": "z", "angle": "entity.wingAngle"},
                "@space": "override",
                "@smoothing": {"rightWing": 1}
              },
              {
                "core:rotate": {"bone": "leftWing", "axis": "z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "override",
                "@smoothing": {"leftWing": 1}
              }
            ]
          }
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/walk.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@smoothing": {"rightLeg": 1.25, "foreRightLeg": 1.25, "leftLeg": 1.25, "foreLeftLeg": 1.25}
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
              {
                "core:rotate": {"bone": "rightWing", "axis": "z", "angle": "entity.wingAngle"},
                "@space": "override",
                "@smoothing": {"rightWing": 1}
              },
              {
                "core:rotate": {"bone": "leftWing", "axis": "z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "override",
                "@smoothing": {"leftWing": 1}
              }
            ]
          }
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/jump.json"},
                "@smoothing": {"rightLeg": 3.33, "foreRightLeg": 3.33, "leftLeg": 3.33, "foreLeftLeg": 3.33}
              },
              {
                "core:rotate": {"bone": "head", "axis": "y", "angle": "entityHeadYaw"},
                "@space": "override",
                "@smoothing": {"head": 2}
              },
              {"core:rotate": {"bone": "head", "axis": "x", "angle": "entityHeadPitch"}, "@space": "post"},
              {
                "core:rotate": {"bone": "rightWing", "axis": "z", "angle": "entity.wingAngle"},
                "@space": "override",
                "@smoothing": {"rightWing": 1}
              },
              {
                "core:rotate": {"bone": "leftWing", "axis": "z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "override",
                "@smoothing": {"leftWing": 1}
              }
            ]
          }
        }
      }
    }
  ]
}

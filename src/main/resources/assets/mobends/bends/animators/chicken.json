{
  "formatVersion": 2,
  "@define": {"jumping": {"live": {"or": [{"not": ["entityIsOnGround"]}, {"lt": ["entityTicksAfterTouchdown", 1]}]}}},
  "layers": [
    {
      "select": [
        {"when": "animator.jumping", "then": "jump"},
        {"when": "entityIsStandingStill", "then": "stand"},
        {"then": "walk"}
      ],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/rest.json"},
                "@damping": {"rightLeg": 0.5, "foreRightLeg": 0.5, "leftLeg": 0.5, "foreLeftLeg": 0.5}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.09]}, "clipLength"]}
                },
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "PRE",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "entity.wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          }
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/walk.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@damping": {"rightLeg": 0.8, "foreRightLeg": 0.8, "leftLeg": 0.8, "foreLeftLeg": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "entity.wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          }
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/jump.json"},
                "@damping": {"rightLeg": 0.3, "foreRightLeg": 0.3, "leftLeg": 0.3, "foreLeftLeg": 0.3}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "POST"
              },
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "entity.wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["entity.wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          }
        }
      }
    }
  ]
}

{
  "formatVersion": 2,
  "layers": [
    {
      "expressions": {
        "jumping": {
          "or": [
            "AIRBORNE",
            {
              "lt": [
                "ticksAfterTouchdown",
                1
              ]
            }
          ]
        }
      },
      "select": [
        {
          "when": "jumping",
          "then": "jump"
        },
        {
          "when": "STANDING_STILL",
          "then": "stand"
        },
        {
          "then": "walk"
        }
      ],
      "nodes": {
        "stand": {
          "type": "core:pose",
          "tags": [
            "stand"
          ],
          "pose": [
            {
              "animationKey": "mobends:bends/animations/chicken/rest.json",
              "damping": {
                "rightLeg": 0.5,
                "foreRightLeg": 0.5,
                "leftLeg": 0.5,
                "foreLeftLeg": 0.5
              }
            },
            {
              "animationKey": "mobends:bends/animations/chicken/idle.json",
              "frame": {
                "mod": [
                  {
                    "mul": [
                      "ticks",
                      0.09
                    ]
                  },
                  "clipLength"
                ]
              },
              "damping": {
                "head": 0.5
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Y",
              "angle": "headYaw",
              "space": "PRE",
              "damping": {
                "head": 0.5
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "X",
              "angle": "headPitch",
              "space": "POST"
            },
            {
              "driver": "core:axis_rotate",
              "bone": "rightWing",
              "axis": "Z",
              "angle": "wingAngle",
              "space": "OVERRIDE",
              "damping": {
                "rightWing": 1
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "leftWing",
              "axis": "Z",
              "angle": {
                "mul": [
                  "wingAngle",
                  -1
                ]
              },
              "space": "OVERRIDE",
              "damping": {
                "leftWing": 1
              }
            }
          ]
        },
        "walk": {
          "type": "core:pose",
          "tags": [
            "walk"
          ],
          "pose": [
            {
              "animationKey": "mobends:bends/animations/chicken/walk.json",
              "frame": {
                "mod": [
                  {
                    "mul": [
                      "limbSwing",
                      0.6662
                    ]
                  },
                  "clipLength"
                ]
              },
              "weight": "limbSwingAmount",
              "damping": {
                "rightLeg": 0.8,
                "foreRightLeg": 0.8,
                "leftLeg": 0.8,
                "foreLeftLeg": 0.8
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Y",
              "angle": "headYaw",
              "space": "OVERRIDE",
              "damping": {
                "head": 0.5
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "X",
              "angle": "headPitch",
              "space": "POST"
            },
            {
              "driver": "core:axis_rotate",
              "bone": "rightWing",
              "axis": "Z",
              "angle": "wingAngle",
              "space": "OVERRIDE",
              "damping": {
                "rightWing": 1
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "leftWing",
              "axis": "Z",
              "angle": {
                "mul": [
                  "wingAngle",
                  -1
                ]
              },
              "space": "OVERRIDE",
              "damping": {
                "leftWing": 1
              }
            }
          ]
        },
        "jump": {
          "type": "core:pose",
          "tags": [
            "jump"
          ],
          "pose": [
            {
              "animationKey": "mobends:bends/animations/chicken/jump.json",
              "damping": {
                "rightLeg": 0.3,
                "foreRightLeg": 0.3,
                "leftLeg": 0.3,
                "foreLeftLeg": 0.3
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Y",
              "angle": "headYaw",
              "space": "OVERRIDE",
              "damping": {
                "head": 0.5
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "X",
              "angle": "headPitch",
              "space": "POST"
            },
            {
              "driver": "core:axis_rotate",
              "bone": "rightWing",
              "axis": "Z",
              "angle": "wingAngle",
              "space": "OVERRIDE",
              "damping": {
                "rightWing": 1
              }
            },
            {
              "driver": "core:axis_rotate",
              "bone": "leftWing",
              "axis": "Z",
              "angle": {
                "mul": [
                  "wingAngle",
                  -1
                ]
              },
              "space": "OVERRIDE",
              "damping": {
                "leftWing": 1
              }
            }
          ]
        }
      }
    }
  ]
}
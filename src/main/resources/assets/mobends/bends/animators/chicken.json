{
  "formatVersion": 2,
  "layers": [
    {
      "@expressions": {"jumping": {"or": ["AIRBORNE", {"lt": ["ticksAfterTouchdown", 1]}]}},
      "select": [{"when": "jumping", "then": "jump"}, {"when": "STANDING_STILL", "then": "stand"}, {"then": "walk"}],
      "nodes": {
        "stand": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/rest.json"},
                "@damping": {"rightLeg": 0.5, "foreRightLeg": 0.5, "leftLeg": 0.5, "foreLeftLeg": 0.5}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/idle.json",
                  "frame": {"mod": [{"mul": ["ticks", 0.09]}, "clipLength"]}
                },
                "@damping": {"head": 0.5}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"},
                "@space": "PRE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          },
          "@tags": ["stand"]
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/chicken/walk.json",
                  "frame": {"mod": [{"mul": ["limbSwing", 0.6662]}, "clipLength"]},
                  "weight": "limbSwingAmount"
                },
                "@damping": {"rightLeg": 0.8, "foreRightLeg": 0.8, "leftLeg": 0.8, "foreLeftLeg": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          },
          "@tags": ["walk"]
        },
        "jump": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/chicken/jump.json"},
                "@damping": {"rightLeg": 0.3, "foreRightLeg": 0.3, "leftLeg": 0.3, "foreLeftLeg": 0.3}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "headYaw"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {"core:axis_rotate": {"bone": "head", "axis": "X", "angle": "headPitch"}, "@space": "POST"},
              {
                "core:axis_rotate": {"bone": "rightWing", "axis": "Z", "angle": "wingAngle"},
                "@space": "OVERRIDE",
                "@damping": {"rightWing": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftWing", "axis": "Z", "angle": {"mul": ["wingAngle", -1]}},
                "@space": "OVERRIDE",
                "@damping": {"leftWing": 1}
              }
            ]
          },
          "@tags": ["jump"]
        }
      }
    }
  ]
}

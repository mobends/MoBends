{
  "formatVersion": 2,
  "@comment": "The quadruped, with the body bobbing on each footfall while walking and the head following through behind it.",
  "extends": "mobends:bends/animators/quadruped.json",
  "layers": [
    {
      "@comment": "Two footfalls per walk cycle, so the bob runs at twice the leg swing; the body is lowest when the legs are furthest apart. The head repeats the bob a little later and nods after it.",
      "mode": "ADDITIVE",
      "additiveSpace": "POST",
      "@define": {"step": {"live": {"mul": ["entityLimbSwing", 0.6662, 2]}}},
      "select": [
        {"when": "animator.walking", "then": "walk", "transitionDuration": 4},
        {"then": "still", "transitionDuration": 4}
      ],
      "nodes": {
        "still": {"core:fallthrough": {}},
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:offset": {
                  "bone": "body",
                  "x": 0,
                  "y": {"mul": [{"cos": ["layer.step"]}, 0.4, "entityLimbSwingAmount"]},
                  "z": 0
                },
                "@space": "OVERRIDE",
                "@damping": {"body": 1}
              },
              {
                "core:offset": {
                  "bone": "head",
                  "x": 0,
                  "y": {"mul": [{"cos": [{"sub": ["layer.step", 0.9]}]}, 0.5, "entityLimbSwingAmount"]},
                  "z": 0
                },
                "@space": "OVERRIDE"
              },
              {
                "core:axis_rotate": {
                  "bone": "head",
                  "axis": "X",
                  "angle": {"mul": [{"cos": [{"sub": ["layer.step", 1.6]}]}, 4, "entityLimbSwingAmount"]}
                },
                "@space": "POST"
              }
            ]
          }
        }
      }
    }
  ]
}

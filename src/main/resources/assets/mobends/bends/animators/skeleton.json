{
  "formatVersion": 2,
  "extends": "mobends:bends/animators/biped.json",
  "layers": [
    {
      "@when": {"and": ["animator.walking", "entityIsStrafing"]},
      "defaultOnEntry": "strafe",
      "nodes": {
        "strafe": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/skeleton/strafe_base.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]}
                },
                "@damping": {"rightLeg": 1, "leftLeg": 1}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/skeleton/strafe_swing.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662]}, "clipLength"]},
                  "weight": "entityLimbSwingAmount"
                },
                "@space": "POST"
              }
            ]
          }
        }
      }
    },
    {
      "@define": {"combo": {"state": 0}, "fist": {"state": 0}},
      "defaultOnEntry": "idle",
      "select": [
        {
          "when": {"mobends:use_action": ["food"]},
          "then": [
            {"when": {"core:active_hand_side": ["right"]}, "then": "eat_right"},
            {"when": {"core:active_hand_side": ["left"]}, "then": "eat_left"}
          ]
        },
        {
          "when": {"mobends:use_action": ["bow"]},
          "then": [
            {"when": {"core:active_hand_side": ["right"]}, "then": "bow_right"},
            {"when": {"core:active_hand_side": ["left"]}, "then": "bow_left"}
          ]
        },
        {
          "when": {"mobends:use_action": ["shield"]},
          "then": [
            {"when": {"core:active_hand_side": ["right"]}, "then": "shield_right"},
            {"when": {"core:active_hand_side": ["left"]}, "then": "shield_left"}
          ]
        },
        {
          "when": {
            "not": [
              {
                "or": [
                  {"mobends:use_action": ["food"]},
                  {"mobends:use_action": ["bow"]},
                  {"mobends:use_action": ["shield"]}
                ]
              }
            ]
          },
          "then": [
            {
              "when": {"mobends:attack_action": ["sword"]},
              "then": "sword",
              "do": [{"set": ["layer.combo", 0]}]
            },
            {
              "when": {"mobends:attack_action": ["fists"]},
              "then": "fists",
              "do": [{"set": ["layer.fist", 0]}]
            },
            {"when": {"mobends:attack_action": ["tool"]}, "then": "tool"}
          ]
        }
      ],
      "nodes": {
        "idle": {"core:pose": {"pose": []}},
        "tool": {
          "core:pose": {
            "pose": [
              {
                "@when": "entityIsSwinging",
                "core:clip": {"animationKey": "mobends:bends/animations/player/tool_rest.json"},
                "@damping": {"centerRotation": 0.3, "localOffset": 0.3},
                "@vectorModes": {"localOffset": "SLIDE"},
                "@mirror": true
              },
              {
                "@when": "entityIsSwinging",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/tool_body.json",
                  "frame": "entitySwingProgress"
                },
                "@damping": {"body": 0.8},
                "@mirror": true
              },
              {
                "@when": {"and": ["entityIsSneaking", "entityIsSwinging"]},
                "core:clip": {"animationKey": "mobends:bends/animations/player/tool_sneak_body.json"},
                "@space": "PRE",
                "@mirror": true
              },
              {
                "@when": {"and": [{"not": ["entityIsSneaking"]}, "entityIsSwinging"]},
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.8},
                "@mirror": true
              },
              {
                "@when": {"and": ["entityIsSneaking", "entityIsSwinging"]},
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": {"add": ["entityHeadPitch", -20]}},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.8},
                "@mirror": true
              },
              {
                "@when": "entityIsSwinging",
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "PRE"
              },
              {
                "@when": "entityIsSwinging",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/tool_head.json",
                  "frame": "entitySwingProgress"
                },
                "@space": "PRE",
                "@mirror": true
              },
              {
                "@when": "entityIsSwinging",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/tool_arm.json",
                  "frame": "entitySwingProgress"
                },
                "@snap": true,
                "@swapSides": true
              },
              {
                "@when": "entityIsSwinging",
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/tool_arm_post.json",
                  "frame": "entitySwingProgress"
                },
                "@space": "POST",
                "@swapSides": true
              }
            ]
          }
        },
        "eat_right": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/eat_arm_right.json",
                  "frame": "node.bringUp"
                }
              },
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": {"mul": ["node.bringUp", -45]}},
                "@space": "OVERRIDE"
              },
              {
                "@when": {"ge": ["nodeTicksElapsed", 6.666666666666667]},
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/eat_head_right.json",
                  "frame": {"mod": ["ticks", "clipLength"]}
                }
              }
            ]
          },
          "@define": {"bringUp": {"live": {"linstep": ["nodeTicksElapsed", 0, 6.666666666666667]}}}
        },
        "bow_right": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/player/localoffset_zero.json"},
                "@damping": {"localOffset": 0.3},
                "@vectorModes": {"localOffset": "SLIDE"}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", -5]}, 50]}},
                "@space": "PRE"
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", 5]}, -50]}},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.8}
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "PRE"
              },
              {
                "@when": "entityIsClimbing",
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": "entityClimbingBodyYaw"},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "X", "angle": {"add": ["entityHeadPitch", -90]}},
                "@space": "OVERRIDE",
                "@damping": {"rightArm": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", -5]}, 50]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "Y", "angle": 80},
                "@space": "OVERRIDE",
                "@damping": {"leftArm": 1}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/bow_offarm_right.json",
                  "frame": {"add": ["entityHeadPitch", 90]}
                },
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "X", "angle": {"max": [{"add": ["entityHeadPitch", -90]}, -160]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": 0},
                "@space": "OVERRIDE",
                "@damping": {"rightForeArm": 1}
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "X", "angle": {"mul": ["node.aimedBowTicks", -3]}},
                "@space": "OVERRIDE"
              }
            ]
          },
          "@define": {"aimedBowTicks": {"live": {"min": ["entityItemUseTicks", 15]}}}
        },
        "shield_right": {
          "core:pose": {
            "pose": [
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "Y", "angle": {"mul": ["node.bringUp", -45]}},
                "@space": "OVERRIDE"
              },
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": {"mul": ["node.bringUp", -45]}},
                "@space": "OVERRIDE"
              }
            ]
          },
          "@define": {"bringUp": {"live": {"linstep": ["nodeTicksElapsed", 0, 1.4285714285714286]}}}
        },
        "eat_left": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/player/eat_arm_left.json", "frame": "node.bringUp"}
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "X", "angle": {"mul": ["node.bringUp", -45]}},
                "@space": "OVERRIDE"
              },
              {
                "@when": {"ge": ["nodeTicksElapsed", 6.666666666666667]},
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/eat_head_left.json",
                  "frame": {"mod": ["ticks", "clipLength"]}
                }
              }
            ]
          },
          "@define": {"bringUp": {"live": {"linstep": ["nodeTicksElapsed", 0, 6.666666666666667]}}}
        },
        "bow_left": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {"animationKey": "mobends:bends/animations/player/localoffset_zero.json"},
                "@damping": {"localOffset": 0.3},
                "@vectorModes": {"localOffset": "SLIDE"}
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "OVERRIDE",
                "@damping": {"head": 0.5}
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", 5]}, -50]}},
                "@space": "PRE"
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", -5]}, 50]}},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.8}
              },
              {
                "@when": {"not": ["entityIsClimbing"]},
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "PRE"
              },
              {
                "@when": "entityIsClimbing",
                "core:axis_rotate": {"bone": "body", "axis": "Y", "angle": "entityClimbingBodyYaw"},
                "@space": "OVERRIDE",
                "@damping": {"body": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "X", "angle": {"add": ["entityHeadPitch", -90]}},
                "@space": "OVERRIDE",
                "@damping": {"leftArm": 0.8}
              },
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "Y", "angle": {"add": [{"mul": ["node.aimedBowTicks", 5]}, -50]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "Y", "angle": -80},
                "@space": "OVERRIDE",
                "@damping": {"rightArm": 1}
              },
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/player/bow_offarm_left.json",
                  "frame": {"add": ["entityHeadPitch", 90]}
                },
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "rightArm", "axis": "X", "angle": {"max": [{"add": ["entityHeadPitch", -90]}, -160]}},
                "@space": "PRE"
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "X", "angle": 0},
                "@space": "OVERRIDE",
                "@damping": {"leftForeArm": 1}
              },
              {
                "core:axis_rotate": {"bone": "rightForeArm", "axis": "X", "angle": {"mul": ["node.aimedBowTicks", -3]}},
                "@space": "OVERRIDE"
              }
            ]
          },
          "@define": {"aimedBowTicks": {"live": {"min": ["entityItemUseTicks", 15]}}}
        },
        "shield_left": {
          "core:pose": {
            "pose": [
              {
                "core:axis_rotate": {"bone": "leftArm", "axis": "Y", "angle": {"mul": ["node.bringUp", 45]}},
                "@space": "OVERRIDE"
              },
              {
                "core:axis_rotate": {"bone": "leftForeArm", "axis": "X", "angle": {"mul": ["node.bringUp", -45]}},
                "@space": "OVERRIDE"
              }
            ]
          },
          "@define": {"bringUp": {"live": {"linstep": ["nodeTicksElapsed", 0, 1.4285714285714286]}}}
        }
      },
      "machines": {
        "sword": {
          "defaultOnEntry": "sword_idle",
          "@define": {"attacked": {"live": {"decreased": ["entityTicksAfterAttack"]}}},
          "select": [
            {
              "when": {
                "and": [
                  {
                    "and": [
                      {"ge": ["entityTicksAfterAttack", 10]},
                      {"lt": ["entityTicksAfterAttack", 60]},
                      "entityIsOnGround"
                    ]
                  },
                  "entityIsSprinting"
                ]
              },
              "then": "stance_sprint"
            },
            {
              "when": {
                "and": [
                  {
                    "and": [
                      {"ge": ["entityTicksAfterAttack", 10]},
                      {"lt": ["entityTicksAfterAttack", 60]},
                      "entityIsOnGround"
                    ]
                  },
                  {"not": ["entityIsSprinting"]},
                  "entityIsStandingStill"
                ]
              },
              "then": "stance"
            },
            {"when": {"ge": ["entityTicksAfterAttack", 10]}, "then": "sword_idle"}
          ],
          "@connections": [
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 0]}]},
              "then": "slash_up",
              "do": [{"set": ["layer.combo", 1]}]
            },
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 1]}]},
              "then": "slash_down",
              "do": [{"set": ["layer.combo", 2]}]
            },
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 2]}]},
              "then": "slash_inward",
              "do": [{"set": ["layer.combo", 3]}]
            },
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 3]}]},
              "then": "slash_outward",
              "do": [{"set": ["layer.combo", 4]}]
            },
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 4]}, "CAN_SPIN_ATTACK"]},
              "then": "slash_whirl",
              "do": [{"set": ["layer.combo", 0]}]
            },
            {
              "when": {"and": ["machine.attacked", {"eq": ["layer.combo", 4]}, {"not": ["CAN_SPIN_ATTACK"]}]},
              "then": "slash_up",
              "do": [{"set": ["layer.combo", 1]}]
            }
          ],
          "nodes": {
            "sword_idle": {
              "core:pose": {"pose": []},
              "@on": {"update": [{"@when": {"gt": ["entityTicksAfterAttack", 20]}, "set": ["layer.combo", 0]}]}
            },
            "stance": {
              "core:pose": {
                "pose": [
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/player/stance_arms.json"},
                    "@damping": {"rightArm": 0.3, "leftArm": 0.3},
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_breath0.json",
                      "frame": {"mod": [{"mul": ["ticks", 0.2]}, "clipLength"]},
                      "bones": ["body"]
                    },
                    "@damping": {"body": 0.3}
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_breath0.json",
                      "frame": {"mod": [{"mul": ["ticks", 0.2]}, "clipLength"]},
                      "bones": ["rightArm"]
                    },
                    "@space": "POST",
                    "@swapSides": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_breath0.json",
                      "frame": {"mod": [{"mul": ["ticks", 0.2]}, "clipLength"]},
                      "bones": ["head"]
                    },
                    "@space": "PRE",
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_breath1.json",
                      "frame": {"mod": [{"mul": ["ticks", 0.17543859649122806]}, "clipLength"]},
                      "bones": ["leftArm"]
                    },
                    "@space": "POST",
                    "@swapSides": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_breath1.json",
                      "frame": {"mod": [{"mul": ["ticks", 0.17543859649122806]}, "clipLength"]},
                      "bones": ["rightArm"]
                    },
                    "@space": "PRE",
                    "@swapSides": true
                  },
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/player/stance_const.json"},
                    "@damping": {
                      "rightLeg": 0.3,
                      "leftLeg": 0.3,
                      "rightForeLeg": 0.3,
                      "leftForeLeg": 0.3,
                      "rightForeArm": 0.3,
                      "leftForeArm": 0.3,
                      "renderRightItemRotation": 0.3,
                      "renderRotation": 0.6,
                      "root": [null, 1.2, null]
                    },
                    "@vectorModes": {"root": "SLIDE"},
                    "@mirror": true
                  },
                  {
                    "@when": {"lt": ["entityTicksAfterTouchdown", 6.666666666666667]},
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/stance_kneel.json",
                      "frame": "entityTicksAfterTouchdown"
                    },
                    "@damping": {"body": 1},
                    "@vectorModes": {"root": "SNAP"}
                  }
                ]
              },
              "@on": {"update": [{"@when": {"gt": ["entityTicksAfterAttack", 20]}, "set": ["layer.combo", 0]}]}
            },
            "stance_sprint": {
              "core:pose": {
                "pose": [
                  {
                    "@when": {"mobends:attack_action": ["sword"]},
                    "mobends:sword_trail": {"velocity": [0, 0, -10]}
                  },
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/player/localoffset_zero.json"},
                    "@damping": {"localOffset": 0.3},
                    "@vectorModes": {"localOffset": "SLIDE"}
                  },
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/player/stance_sprint_abs.json"},
                    "@damping": {"renderRightItemRotation": 0.3},
                    "@mirror": true
                  },
                  {
                    "core:clip": {"animationKey": "mobends:bends/animations/player/stance_sprint_pre.json"},
                    "@space": "PRE",
                    "@mirror": true
                  }
                ]
              },
              "@on": {"update": [{"@when": {"gt": ["entityTicksAfterAttack", 20]}, "set": ["layer.combo", 0]}]}
            },
            "slash_up": {
              "core:pose": {
                "pose": [
                  {
                    "@when": {"and": [{"lt": ["entityTicksAfterAttack", 4]}, {"mobends:attack_action": ["sword"]}]},
                    "mobends:sword_trail": {"resetOnEnter": true}
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up.json",
                      "bones": ["body", "leftArm", "leftForeArm", "rightForeArm", "localOffset"],
                      "frame": "entityTicksAfterAttack"
                    },
                    "@damping": {"body": 0.9, "leftArm": 0.3, "leftForeArm": 0.3, "rightForeArm": 0.3, "localOffset": 0.3},
                    "@vectorModes": {"localOffset": "SLIDE"},
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up.json",
                      "bones": ["rightArm"],
                      "frame": "entityTicksAfterAttack"
                    },
                    "@damping": {"rightArm": 0.9},
                    "@snap": false,
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up.json",
                      "bones": ["renderRightItemRotation"],
                      "frame": "entityTicksAfterAttack"
                    },
                    "@damping": {"renderRightItemRotation": 0.9},
                    "@snap": true,
                    "@mirror": true
                  },
                  {
                    "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                    "@space": "OVERRIDE",
                    "@damping": {"head": 0.9},
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up.json",
                      "bones": ["head"],
                      "frame": "entityTicksAfterAttack"
                    },
                    "@space": "PRE",
                    "@mirror": true
                  },
                  {
                    "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                    "@space": "PRE"
                  },
                  {
                    "@when": {"and": ["entityIsStandingStill", {"not": ["entityIsRiding"]}]},
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up_still.json",
                      "bones": ["leftLeg", "rightLeg", "leftForeLeg", "rightForeLeg", "root"]
                    },
                    "@damping": {"root": [null, 1.2, null]},
                    "@vectorModes": {"root": "SLIDE"}
                  },
                  {
                    "@when": {"and": ["entityIsStandingStill", {"not": ["entityIsRiding"]}]},
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_up_still.json",
                      "bones": ["renderRotation"]
                    },
                    "@damping": {"renderRotation": 0.6},
                    "@mirror": true
                  }
                ]
              }
            },
            "slash_inward": {
              "core:pose": {
                "pose": [
                  {
                    "@when": {"and": [{"lt": ["entityTicksAfterAttack", 4]}, {"mobends:attack_action": ["sword"]}]},
                    "mobends:sword_trail": {"resetOnEnter": true}
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_inward.json",
                      "bones": ["body", "leftArm", "leftForeArm", "rightForeArm", "localOffset"],
                      "frame": "entityTicksAfterAttack"
                    },
                    "@damping": {"body": 0.9, "leftArm": 0.3, "leftForeArm": 0.3, "rightForeArm": 0.3, "localOffset": 0.3},
                    "@vectorModes": {"localOffset": "SLIDE"},
                    "@mirror": true
                  },
                  {
                    "core:clip": {
                      "animationKey": "mobends:bends/animations/player/slash_inward.json",
                      "bones": ["rightArm"],

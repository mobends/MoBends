{
  "formatVersion": 2,
  "@comment": "The wolf: keyframe clips for the body and the mouth, and the vanilla expressions as drivers on top.",
  "@define": {
    "tailWag": {"@comment": "Vanilla's tail wag: the interested angle (in radians) times a wave over the wolf's age.",
                "live": {"mul": [{"div": [{"mobends:wolf_interested_angle": []}, 57.29578]},
                                 {"mcsin": [{"add": ["entityTicksExisted", "partialTicks"]}]}, 20]}}
  },
  "layers": [
    {
      "@comment": "The body clips. Every clip is hard-set (snap): the wolf's clips were authored without smoothing.",
      "defaultOnEntry": "idle",
      "nodes": {
        "idle": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/idle.json",
                  "frame": {"mod": ["nodeTicksElapsed", "clipLength"]}
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [
            {"when": {"not": ["entityIsStandingStill"]}, "then": "walk", "transitionDuration": 4},
            {"when": {"mobends:is_sitting": []}, "then": "sit_down", "transitionDuration": 3}
          ]
        },
        "walk": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/walking.json",
                  "frame": {"mod": [{"mul": ["entityLimbSwing", 0.6662, 4]}, "clipLength"]}
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [
            {"when": "entityIsStandingStill", "then": "idle", "transitionDuration": 4},
            {"when": {"mobends:is_sitting": []}, "then": "sit_down", "transitionDuration": 1}
          ]
        },
        "sit_down": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/sitting_down.json",
                  "frame": {"add": [6, {"mul": ["nodeTicksElapsed", 2]}]},
                  "duration": 8
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [{"when": "nodeIsFinished", "then": "sit", "transitionDuration": 1}]
        },
        "sit": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/sitting.json",
                  "frame": {"mod": ["nodeTicksElapsed", "clipLength"]}
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [{"when": {"not": [{"mobends:is_sitting": []}]}, "then": "stand_up", "transitionDuration": 1}]
        },
        "stand_up": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/standing_up.json",
                  "frame": {"add": [4, {"mul": ["nodeTicksElapsed", 2]}]},
                  "duration": 9
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [{"when": "nodeIsFinished", "then": "idle", "transitionDuration": 1}]
        }
      }
    },
    {
      "@comment": "The mouth and tongue alternate between idling and panting.",
      "defaultOnEntry": "idle",
      "mask": {"mode": "INCLUDE_ONLY", "includedParts": ["tongue", "mouth"]},
      "nodes": {
        "idle": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/idle.json",
                  "frame": {"mod": ["nodeTicksElapsed", "clipLength"]}
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [{"when": {"gt": ["nodeTicksElapsed", 80]}, "then": "breathe", "transitionDuration": 4}]
        },
        "breathe": {
          "core:pose": {
            "pose": [
              {
                "core:clip": {
                  "animationKey": "mobends:bends/animations/wolf/breathing.json",
                  "frame": {"mod": [{"mul": ["nodeTicksElapsed", 1.2]}, "clipLength"]}
                },
                "@space": "OVERRIDE",
                "@snap": true
              }
            ]
          },
          "@connections": [{"when": {"gt": ["nodeTicksElapsed", 50]}, "then": "idle", "transitionDuration": 4}]
        }
      }
    },
    {
      "@comment": "The look direction, the interested tilt, the shaking and the tail (vanilla expressions) applied after the clips in each bone's own space; the clips' head offset is discarded.",
      "mode": "ADDITIVE",
      "defaultOnEntry": "look",
      "nodes": {
        "look": {
          "core:pose": {
            "pose": [
              {
                "core:axis_rotate": {"bone": "head", "axis": "Y", "angle": "entityHeadYaw"},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "X", "angle": "entityHeadPitch"},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Z", "angle": {"mobends:wolf_interested_angle": []}},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "head", "axis": "Z", "angle": {"mobends:wolf_shake_angle": [0]}},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "mane", "axis": "Z", "angle": {"mobends:wolf_shake_angle": [-0.08]}},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "tail", "axis": "Z", "angle": {"mobends:wolf_shake_angle": [-0.2]}},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "tail", "axis": "Z", "angle": "animator.tailWag"},
                "@space": "POST",
                "@snap": true
              },
              {
                "core:axis_rotate": {"bone": "tail", "axis": "X", "angle": {"add": [{"mobends:wolf_tail_rotation": []}, -90]}},
                "@space": "POST",
                "@snap": true
              },
              {"core:offset": {"bone": "head", "x": 0, "y": 0, "z": 0}, "@space": "OVERRIDE"}
            ]
          }
        }
      }
    }
  ]
}

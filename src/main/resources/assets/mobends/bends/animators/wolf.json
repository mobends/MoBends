{
  "formatVersion": 2,
  "comment": "The wolf: the keyframe clips of wolf_clips.json plus the vanilla expressions as drivers.",
  "extends": "mobends:bends/animators/wolf_clips.json",
  "layers": [
    {
      "comment": "The look direction, the interested tilt, the shaking and the tail (vanilla expressions) applied after the clips in each bone's own space; the clips' head offset is discarded.",
      "type": "KEYFRAME",
      "mode": "ADDITIVE",
      "entryNode": "look",
      "nodes": {
        "look": {
          "type": "core:pose",
          "pose": [
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Y",
              "angle": {
                "variable": "headYaw"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "X",
              "angle": {
                "variable": "headPitch"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Z",
              "angle": {
                "variable": "interestedAngle"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "head",
              "axis": "Z",
              "angle": {
                "variable": "shakeAngleHead"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "mane",
              "axis": "Z",
              "angle": {
                "variable": "shakeAngleMane"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "tail",
              "axis": "Z",
              "angle": {
                "variable": "shakeAngleTail"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "tail",
              "axis": "Z",
              "angle": {
                "variable": "tailWag"
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:axis_rotate",
              "bone": "tail",
              "axis": "X",
              "angle": {
                "variable": "tailRotation",
                "offset": -90
              },
              "space": "POST",
              "snap": true
            },
            {
              "driver": "core:offset",
              "bone": "head",
              "x": 0,
              "y": 0,
              "z": 0,
              "space": "OVERRIDE"
            }
          ]
        }
      }
    }
  ]
}